---
import LiveEngineStage from './LiveEngineStage.astro';
import { LEDGER_76DAY } from '../data/telemetry';

const GITHUB_URL = 'https://github.com/ApatheticMioz/Castor';

/** Interactive client switcher — switches the live command in the embedded OLED CLI bar. */
const CLIENTS: Array<{ id: string; label: string; cmd: string }> = [
  { id: 'all', label: 'All Clients', cmd: 'npx -y mcp-castor install --client all' },
  { id: 'claude', label: 'Claude Code', cmd: 'npx -y mcp-castor install --client claude' },
  { id: 'antigravity', label: 'Antigravity', cmd: 'npx -y mcp-castor install --client antigravity' },
  { id: 'cargo', label: 'Air-Gap (Cargo)', cmd: 'cargo install --path . --no-default-features --features mcp,ast' },
];

/**
 * Live ledger strip — 3-cell 1px-gap `.spec-grid` on `--bg-surface`,
 * driven by the layout's [data-count-to] rolling odometers, sourced from
 * the verified 76-day `castor stats` window.
 */
const ledgerCells: Array<{
  countTo: number;
  decimals: number;
  prefix?: string;
  suffix?: string;
  label: string;
  sub: string;
}> = [
  {
    countTo: 2.62,
    decimals: 2,
    suffix: 'B',
    label: 'TOKENS (76D)',
    sub: `${LEDGER_76DAY.windowStart} → ${LEDGER_76DAY.windowEnd} · castor stats`,
  },
  {
    countTo: LEDGER_76DAY.cacheHitPct,
    decimals: 1,
    suffix: '%',
    label: 'KV PREFIX HIT',
    sub: `${LEDGER_76DAY.cachedTokensDisplay} cached / ${LEDGER_76DAY.promptTokensDisplay} prompt`,
  },
  {
    countTo: 5703,
    decimals: 0,
    prefix: '$',
    label: 'SAVED VS CLOUD',
    sub: `${LEDGER_76DAY.netSavingsPct}% vs $${LEDGER_76DAY.cloudCounterfactualUsd.toLocaleString('en-US')} API cf`,
  },
];
---

<!--
  Full-bleed hero: hardware dot-grid texture fading into the paper ground
  at the bottom edge; asymmetric 12-column grid inside.
-->
<section class="relative max-w-full overflow-x-clip">
  <div
    class="hardware-dot-grid absolute inset-0"
    aria-hidden="true"
    style="mask-image: linear-gradient(to bottom, black 0%, black 55%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 0%, black 55%, transparent 100%);"
  ></div>

  <div
    class="relative mx-auto grid max-w-[1360px] items-start gap-10 px-4 pb-14 pt-10 sm:px-6 lg:grid-cols-12 lg:px-8 lg:pb-20 lg:pt-16"
  >
    <!-- ── Left: headline, subhead, installer, ledger ─────────────────── -->
    <div class="min-w-0 lg:col-span-5">
      <!-- Crisp mono technical eyebrow (NOT a pill) with a live 6px OK dot -->
      <p
        class="flex items-center gap-2.5 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-secondary"
      >
        <span
          class="relative flex h-1.5 w-1.5 shrink-0"
          aria-hidden="true"
        >
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-ok opacity-40"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-ok"></span>
        </span>
        RUST MCP MICROKERNEL · AGPL-3.0 · 76-DAY LEDGER
      </p>

      <!-- Masked upward reveal: the layout script animates [data-hero-reveal] -->
      <h1
        class="mt-4 font-display text-[clamp(2.55rem,4.6vw,4.35rem)] font-bold leading-[0.96] tracking-[-0.04em] text-ink"
      >
        <span class="block overflow-hidden">
          <span class="block" data-hero-reveal>Keep your frontier model.</span>
        </span>
        <span class="block overflow-hidden">
          <span class="block" data-hero-reveal
            ><span class="text-local">Stop paying it</span> to read files.</span
          >
        </span>
      </h1>

      <p
        class="mt-5 max-w-[46ch] font-sans text-base leading-relaxed text-ink-secondary sm:text-[17px]"
      >
        Castor pairs your cloud Lead Architect (Claude Opus 5.5, Fable 5.2,
        Gemini 4 Neon, GPT-6.2 Astra) with
        <code class="am-code">Qwen3.8-27B</code>
        running locally on your GPU — offloading file exploration, AST edits,
        and test loops at <span class="font-semibold text-ink">$0.00</span> per
        token inside a 5-layer sandbox.
      </p>

      <!-- Interactive client switcher: 2×2 grid on 375–390px mobile,
           4-across from `sm` — all four tabs always fit with zero overflow. -->
      <div
        class="mt-6 grid grid-cols-2 gap-[2px] sm:grid-cols-4"
        role="tablist"
        aria-label="Install target client"
      >
        {CLIENTS.map((c, i) => (
          <button
            type="button"
            role="tab"
            id={`hero-client-${c.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-client={c.id}
            data-cmd={c.cmd}
            class={`hero-client min-w-0 px-2 py-2 text-left font-mono text-[11px] uppercase tracking-[0.08em] transition-colors duration-120 sm:px-3.5 ${
              i === 0 ? 'is-active' : ''
            }`}
          >
            {c.label}
          </button>
        ))}
      </div>

      <!-- Embedded dark OLED CLI installer -->
      <div
        class="instrument-chassis mt-2 flex items-stretch"
        role="tabpanel"
        aria-labelledby="hero-client-all"
      >
        <span
          class="flex min-w-0 flex-1 items-center gap-2.5 px-3.5 py-3 sm:px-4"
        >
          <span
            class="shrink-0 font-mono text-[15px] leading-none text-[#F97316]"
            aria-hidden="true"
            >$</span
          >
          <code
            id="hero-cmd"
            class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap font-mono text-[12px] leading-snug text-[#F3F5F8] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:text-[13px]"
          >npx -y mcp-castor install <span class="whitespace-nowrap">--client all</span></code
          >
        </span>
        <button
          type="button"
          id="hero-copy"
          class="tactile-btn tactile-btn--primary shrink-0 rounded-none border-0 border-l border-l-[#1E2430] px-4 sm:px-5"
          aria-label="Copy install command"
        >
          <span data-copy-label>COPY</span>
          <span data-copy-done class="whitespace-nowrap" style="display: none;">
            COPIED ✓
          </span>
        </button>
      </div>

      <!-- Secondary CTA strip: flex-wrap so nothing clips at 390px -->
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
        <a
          href="#speed-race"
          class="tactile-btn tactile-btn--secondary px-3.5 py-2 text-[12px]"
        >
          Run Live Race ↓
        </a>
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noreferrer"
          class="font-mono text-[13px] text-ink-secondary transition-colors duration-150 hover:text-ink"
        >
          View on GitHub →
        </a>
        <a
          href="#deploy"
          class="font-mono text-[13px] text-ink-secondary transition-colors duration-150 hover:text-ink"
        >
          Enterprise Pilot →
        </a>
      </div>

      <!-- Live ledger strip: 3-cell 1px-gap spec grid, odometer-rolled -->
      <div class="spec-grid mt-8 grid-cols-3">
        {ledgerCells.map((cell) => (
          <div class="min-w-0 p-3 sm:p-4">
            <p
              class="tabular font-display text-lg font-bold tracking-tight text-ink sm:text-2xl"
              data-count-to={cell.countTo}
              data-decimals={cell.decimals}
              {...(cell.prefix ? { 'data-prefix': cell.prefix } : {})}
              {...(cell.suffix ? { 'data-suffix': cell.suffix } : {})}
            >
              {`${cell.prefix ?? ''}${cell.countTo.toLocaleString('en-US', {
                minimumFractionDigits: cell.decimals,
                maximumFractionDigits: cell.decimals,
              })}${cell.suffix ?? ''}`}
            </p>
            <p
              class="mt-1 font-mono text-[10px] uppercase tracking-[0.1em] leading-[1.4] text-ink-muted"
            >
              {cell.label}
            </p>
            <p
              class="tabular mt-1 font-mono text-[10px] leading-[1.4] text-ink-secondary"
            >
              {cell.sub}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- ── Right: alive embedded OLED hardware instrument ────────────── -->
    <div class="min-w-0 lg:col-span-7">
      <LiveEngineStage />
    </div>
  </div>

  <style>
    /* ── Client switch keys: recessed default, raised + 2px local-ink top
         bar when active. Theme-aware via tokens — zero hardcoded hex. ── */
    .hero-client {
      background: var(--bg-recessed);
      border: 1px solid var(--border-hairline);
      color: var(--ink-muted);
      cursor: pointer;
    }
    .hero-client:hover {
      color: var(--ink-secondary);
      border-color: var(--border-strong);
    }
    .hero-client.is-active {
      position: relative;
      background: var(--bg-surface);
      border-color: var(--border-ink);
      color: var(--ink-primary);
    }
    .hero-client.is-active::before {
      content: '';
      position: absolute;
      top: -1px;
      left: -1px;
      right: -1px;
      height: 2px;
      background: var(--signal-local);
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-client {
        transition: none;
      }
    }
  </style>

  <script>
    // Client switcher: swaps the live command in the OLED bar + tab ARIA.
    (() => {
      const tabs = Array.from(
        document.querySelectorAll<HTMLButtonElement>('.hero-client'),
      );
      const code = document.getElementById('hero-cmd');
      const panel = document.getElementById('hero-cmd')?.closest<HTMLElement>('[role="tabpanel"]');
      if (tabs.length === 0 || !code) return;

      const setTab = (t: HTMLButtonElement) => {
        for (const b of tabs) {
          const on = b === t;
          b.setAttribute('aria-selected', String(on));
          b.classList.toggle('is-active', on);
        }
        if (t.dataset.cmd) code.textContent = t.dataset.cmd;
        panel?.setAttribute('aria-labelledby', t.id);
      };

      for (const t of tabs) {
        t.addEventListener('click', () => setTab(t));
        t.addEventListener('keydown', (e) => {
          const i = tabs.indexOf(t);
          if (e.key === 'ArrowRight') {
            e.preventDefault();
            const n = tabs[(i + 1) % tabs.length];
            n.focus();
            setTab(n);
          } else if (e.key === 'ArrowLeft') {
            e.preventDefault();
            const n = tabs[(i - 1 + tabs.length) % tabs.length];
            n.focus();
            setTab(n);
          }
        });
      }
    })();

    // Copy-to-clipboard for the embedded OLED installer bar.
    (() => {
      const btn = document.getElementById('hero-copy');
      const code = document.getElementById('hero-cmd');
      if (!btn || !code) return;

      const label = btn.querySelector<HTMLSpanElement>('[data-copy-label]');
      const done = btn.querySelector<HTMLSpanElement>('[data-copy-done]');
      let timer = 0;

      const show = (copied: boolean) => {
        if (!label || !done) return;
        label.style.display = copied ? 'none' : 'inline';
        done.style.display = copied ? 'inline' : 'none';
        btn.setAttribute('aria-label', copied ? 'Copied' : 'Copy install command');
      };

      btn.addEventListener('click', async () => {
        const text = code.textContent ?? '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          // Non-secure context: transient select for manual copy.
          try {
            const range = document.createRange();
            range.selectNodeContents(code);
            const sel = window.getSelection();
            sel?.removeAllRanges();
            sel?.addRange(range);
            window.setTimeout(() => sel?.removeAllRanges(), 2000);
          } catch {
            /* degrade silently */
          }
        }
        show(true);
        window.clearTimeout(timer);
        timer = window.setTimeout(() => show(false), 2000);
      });
    })();
  </script>
</section>
