---
import {
  PATH_LAYERS,
  COMPANION_GATES,
  VECTOR_CASES,
  VECTOR_SUMMARY,
} from '../scripts/security-sandbox';

const S = VECTOR_SUMMARY;
---

<section id="security" data-reveal class="scroll-mt-16 border-y border-hairline bg-ground">
  <!-- Section header -->
  <div class="border-b border-hairline">
    <div class="mx-auto max-w-6xl px-4 py-5 sm:px-6">
      <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        Zero-Trust Workspace Containment. Verified Across 137 Attack Vectors.
      </h2>
      <p class="mt-1 font-mono text-xs text-ink-muted">
        <span class="tabular">{S.blocked} blocked · {S.allowed} allowed</span> ·
        deterministic refusals · source of record
        <span class="text-ink-secondary"> {S.source}</span>
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
    <div class="grid grid-cols-1 gap-px border border-[var(--border-hairline)] bg-[var(--border-hairline)] lg:grid-cols-12">
      <!-- Left · Swiss paper: defense-in-depth stack -->
      <div class="hardware-dot-grid bg-surface p-4 lg:col-span-5">
        <p class="font-mono text-[11px] uppercase tracking-widest text-ink-muted">
          The Defense-in-Depth Stack · <span class="text-ink-secondary">src/tools/sandbox/mod.rs</span>
        </p>

        <!-- 5-layer vertical pipeline -->
        <ol class="mt-3" aria-label="Five-layer path containment pipeline">
          {PATH_LAYERS.map((l, i) => (
            <li class="relative pl-10">
              {i < PATH_LAYERS.length - 1 && (
                <span
                  class="absolute left-[15px] top-6 h-full w-px bg-[var(--border-hairline)]"
                  aria-hidden="true"
                ></span>
              )}
              <span
                class="absolute left-0 top-0 flex h-8 w-8 items-center justify-center border border-[var(--border-strong)] bg-recessed font-mono text-[11px] font-semibold text-ink"
              >
                {l.level}
              </span>
              <div class="pt-1">
                <p class="font-mono text-xs text-ink">{l.fn}</p>
                <p class="mt-0.5 font-mono text-[11px] leading-relaxed text-ink-secondary">
                  {l.role}
                </p>
              </div>
            </li>
          ))}
        </ol>

        <!-- Hairline divider -->
        <div class="my-5 border-t border-[var(--border-hairline)]" aria-hidden="true"></div>

        <p class="font-mono text-[11px] uppercase tracking-widest text-ink-muted">
          Companion Runtime Gates
        </p>
        <ul class="mt-3 space-y-3">
          {COMPANION_GATES.map((g) => (
            <li class="border-l-2 border-l-[var(--signal-local)] pl-3">
              <p class="font-mono text-xs text-ink">{g.name}</p>
              <p class="font-mono text-[10px] text-ink-muted">{g.coord}</p>
              <p class="mt-1 font-mono text-[11px] leading-relaxed text-ink-secondary">
                {g.desc}
              </p>
            </li>
          ))}
        </ul>

        <!-- Air-gap transparency callout -->
        <div class="mt-5 border border-[var(--border-strong)] bg-recessed p-3">
          <p class="font-mono text-[11px] uppercase tracking-widest text-ink-secondary">
            Air-Gap Transparency
          </p>
          <p class="mt-2 font-mono text-[11px] leading-relaxed text-ink-secondary">
            Core MCP + local execution communicate solely over <span class="text-ink">stdio</span>
            and <span class="text-ink">loopback (127.0.0.1)</span>. The optional
            <span class="text-ink"> web_search</span>,
            <span class="text-ink"> web_fetch</span>, and
            <span class="text-ink"> paper_lookup</span> tools are feature/config-gated and can be
            compiled out entirely for strict air-gapped CMMC L2 / ITAR / SCIF deployments.
          </p>
        </div>
      </div>

      <!-- Right · Embedded dark OLED: Live Attack-Vector Monitor -->
      <div class="instrument-chassis p-4 sm:p-5 lg:col-span-7">
        <!-- Monitor header -->
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <span class="ss-led" aria-hidden="true"></span>
            <p class="font-mono text-xs font-semibold uppercase tracking-widest text-ink-instrument">
              Live Attack-Vector Monitor
            </p>
          </div>
          <p class="tabular font-mono text-[11px] text-ink-instrument-muted">
            {S.total} vectors ·
            <span class="text-block-oled">{S.blocked} blocked</span> ·
            <span class="text-ok-oled">{S.allowed} allowed</span>
          </p>
        </div>
        <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
          <p class="font-mono text-[10px] uppercase tracking-wider text-ink-instrument-muted">
            5-layer path pipeline · Landlock · lexical shell scanner · 27-grammar tree-sitter AST gate
          </p>
          <button
            type="button"
            id="ss-auto-demo"
            class="tactile-btn tactile-btn--primary text-[11px] tracking-widest"
            aria-label="Auto-demo all seven security vectors"
          >
            AUTO-DEMO ALL 7 ▶
          </button>
        </div>

        <!-- Vector selectors -->
        <div class="mt-4 space-y-2" role="list" aria-label="Security vector cases">
          {VECTOR_CASES.map((v) => (
            <button
              type="button"
              role="listitem"
              data-vector-id={v.id}
              class="ss-vector flex w-full items-center gap-3 border border-[var(--bg-instrument-border)] bg-[var(--bg-instrument-raised)] px-3 py-2 text-left transition-colors hover:border-[rgba(255,255,255,0.25)]"
            >
              <span
                class={`shrink-0 font-mono text-[10px] font-semibold ${
                  v.verdict === 'blocked' ? 'text-block-oled' : 'text-ok-oled'
                }`}
              >
                {v.verdict === 'blocked' ? 'BLOCK' : 'ALLOW'}
              </span>
              <span class="min-w-0 flex-1 truncate font-mono text-xs text-ink-instrument">
                {v.input}
              </span>
            </button>
          ))}
        </div>

        <!-- Trace panel -->
        <div id="security-vector-probe" class="mt-4 border border-[var(--bg-instrument-border)] bg-[var(--bg-instrument-raised)] p-4">
          <p class="font-mono text-[11px] uppercase tracking-widest text-ink-instrument-muted">
            Layer-by-Layer Gate Trace · 140 ms latch per layer
          </p>
          <ol class="mt-3 space-y-1.5" aria-label="Containment layer trace">
            <li
              data-step="0"
              class="ss-step flex items-center justify-between gap-3 border-b border-[var(--bg-instrument-border)] pb-1.5 font-mono text-[11px] text-ink-instrument"
            >
              <span>L1 · resolve_workspace_root</span>
              <span data-status class="tabular font-semibold">···</span>
            </li>
            <li
              data-step="1"
              class="ss-step flex items-center justify-between gap-3 border-b border-[var(--bg-instrument-border)] pb-1.5 font-mono text-[11px] text-ink-instrument"
            >
              <span>L2 · verify_symlink_containment</span>
              <span data-status class="tabular font-semibold">···</span>
            </li>
            <li
              data-step="2"
              class="ss-step flex items-center justify-between gap-3 border-b border-[var(--bg-instrument-border)] pb-1.5 font-mono text-[11px] text-ink-instrument"
            >
              <span>L3 · refuse_out_of_tree</span>
              <span data-status class="tabular font-semibold">···</span>
            </li>
            <li
              data-step="3"
              class="ss-step flex items-center justify-between gap-3 border-b border-[var(--bg-instrument-border)] pb-1.5 font-mono text-[11px] text-ink-instrument"
            >
              <span>L4 · normalize_traversal</span>
              <span data-status class="tabular font-semibold">···</span>
            </li>
            <li
              data-step="4"
              class="ss-step flex items-center justify-between gap-3 border-b border-[var(--bg-instrument-border)] pb-1.5 font-mono text-[11px] text-ink-instrument"
            >
              <span>L5 · check_binary</span>
              <span data-status class="tabular font-semibold">···</span>
            </li>
            <li
              data-step="5"
              class="ss-step flex items-center justify-between gap-3 font-mono text-[11px] text-ink-instrument"
            >
              <span>Runtime · Landlock · Shell / AST gates</span>
              <span data-status class="tabular font-semibold">···</span>
            </li>
          </ol>

          <div class="mt-4 flex flex-wrap items-center gap-3">
            <span
              id="security-vector-verdict"
              class="ss-verdict border px-3 py-1 font-mono text-[11px] font-semibold"
            >
              TRACING…
            </span>
            <span class="font-mono text-[11px] text-ink-instrument-muted">
              tripped at <span id="security-vector-triplayer" class="text-ink-instrument">—</span>
            </span>
          </div>
          <p
            id="security-vector-struct"
            class="mt-3 border-l-2 border-[var(--signal-block-oled)] pl-3 font-mono text-[11px] leading-relaxed text-ink-instrument"
          >
            —
          </p>
          <p id="security-vector-source" class="mt-2 font-mono text-[10px] text-ink-instrument-muted">
            —
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* OLED monitor status LED — hardware green, constant in both themes. */
  .ss-led {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal-ok-oled);
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.12);
  }
  .ss-vector.is-probing {
    border-color: var(--signal-local-oled);
    background: rgba(249, 115, 22, 0.08);
  }
  .ss-step {
    transition: opacity 140ms linear, border-color 140ms linear, background-color 140ms linear;
  }
  .ss-step[data-status] {
    transition: color 140ms linear;
  }
  .ss-step.is-pending {
    opacity: 0.4;
  }
  .ss-step.is-muted {
    opacity: 0.3;
  }
  .ss-step.is-pass {
    opacity: 1;
    border-color: rgba(34, 197, 94, 0.3);
  }
  .ss-step.is-pass [data-status] {
    color: var(--signal-ok-oled);
  }
  .ss-step.is-allow {
    opacity: 1;
    border-color: rgba(34, 197, 94, 0.3);
  }
  .ss-step.is-allow [data-status] {
    color: var(--signal-ok-oled);
  }
  .ss-step.is-trip {
    opacity: 1;
    border-color: rgba(239, 68, 68, 0.55);
    background: rgba(239, 68, 68, 0.07);
  }
  .ss-step.is-trip [data-status] {
    color: var(--signal-block-oled);
  }
  .ss-verdict {
    border-color: var(--bg-instrument-border);
    color: var(--ink-instrument-muted);
    transition: color 140ms linear, border-color 140ms linear, background-color 140ms linear;
  }
  .ss-verdict.is-blocked {
    border-color: var(--signal-block-oled);
    color: var(--signal-block-oled);
    background: rgba(239, 68, 68, 0.1);
  }
  .ss-verdict.is-allowed {
    border-color: var(--signal-ok-oled);
    color: var(--signal-ok-oled);
    background: rgba(34, 197, 94, 0.1);
  }
  /* Auto-demo button: International Orange hardware key, constant in OLED. */
  .instrument-chassis .tactile-btn--primary {
    background: #e04f00;
    border-color: #e04f00;
    color: #ffffff;
  }
  .instrument-chassis .tactile-btn--primary:hover {
    background: #f97316;
    border-color: #f97316;
  }
  .instrument-chassis .tactile-btn--primary.is-disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  @media (prefers-reduced-motion: reduce) {
    .ss-step,
    .ss-step[data-status],
    .ss-verdict,
    .ss-vector {
      transition: none;
    }
  }
</style>

<script src="../scripts/security-sandbox.ts"></script>
