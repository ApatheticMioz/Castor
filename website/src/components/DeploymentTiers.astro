<script>
  // Tactile copy-to-clipboard for the install command. Uses the async
  // Clipboard API where available; on non-secure contexts the hint degrades
  // to a manual-copy instruction instead of any deprecated clipboard call.
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-copy]'));
  for (const btn of buttons) {
    const hint = btn.querySelector<HTMLSpanElement>('span:last-child');
    btn.addEventListener('click', () => {
      const cmd = btn.dataset.copy ?? '';
      const done = (ok: boolean) => {
        if (!hint) return;
        hint.textContent = ok ? 'copied ✓' : 'select & copy manually';
        hint.classList.toggle('text-local', ok);
        window.clearTimeout((btn as { __copyTimer?: number }).__copyTimer ?? 0);
        (btn as { __copyTimer?: number }).__copyTimer = window.setTimeout(() => {
          hint.textContent = 'copy install command';
          hint.classList.remove('text-local');
        }, 2000);
      };
      if (navigator.clipboard?.writeText) {
        navigator.clipboard.writeText(cmd).then(
          () => done(true),
          () => done(false),
        );
      } else {
        done(false);
      }
    });
  }
</script>
