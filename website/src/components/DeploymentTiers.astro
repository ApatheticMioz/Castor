---
/**
 * Castor — Deployment Tiers (dual funnel: open core + regulated air-gap)
 * Crisp 3-column 1px-gap `.spec-grid` on pure `--bg-surface` sheets. No fake
 * badges, no fake forms, no CTA overlap — real $0 / one-time / mailto CTAs
 * only, with Sprint & Enterprise mailto bodies dynamically personalized from
 * the `castor:economics-update` hook published by the Economics instrument.
 */
import { ARCHITECTURE } from '../data/telemetry';

const GITHUB = ARCHITECTURE.links.github;
const EMAIL = 'ApatheticMioz@gmail.com';

const tiers = [
  {
    key: 'core',
    name: 'Castor Core',
    price: '$0',
    tag: 'AGPL-3.0 Open Source',
    audience:
      'Individual developers & open-source contributors pairing cloud leads with local GPUs (8 GB to 24 GB+).',
    bullets: [
      'Full Rust MCP microkernel (castor_coworker / task / server)',
      '8 core + 2 AST tools + 27 tree-sitter grammars',
      '5-layer sandbox & Linux Landlock enforcement',
      'vLLM / llama.cpp / Ollama / SGLang engine profiles',
      'Live castor stats telemetry (tokens, KV cache, savings)',
    ],
    ctaLabel: null,
    secondary: null,
  },
  {
    key: 'sprint',
    name: 'Turnkey Local Sprint',
    price: '$1,500',
    tag: 'One-Time · 48-Hour Setup',
    audience:
      'Engineering teams standing up dedicated local inference hardware without weeks of vLLM / CUDA / quantization tuning.',
    bullets: [
      'Custom vLLM 0.33 / llama.cpp + MTP/DFlash2 tuning for your GPUs (RTX 3090/4090/5090 or L40S/H100)',
      'Team workspace sandbox & shell policy hardening',
      'IDE onboarding: Claude Code, Antigravity, Cursor',
      'Verified throughput benchmark handoff',
    ],
    ctaLabel: 'Request 48-Hour Sprint →',
    secondary: null,
  },
  {
    key: 'enterprise',
    name: 'Enterprise Air-Gap Pilot',
    price: 'Custom',
    tag: '10–50 Seats · Below Copilot Anchor',
    audience:
      'Fixed-scope compliance pilot (1–3 months, priced under Copilot\u2019s $19–$39/seat/mo anchor) for DIB, defense, finance, and healthcare enclaves where source code cannot touch external APIs.',
    bullets: [
      'Commercial dual-license (AGPL-3.0 opt-out)',
      'Signed air-gapped binary with outbound web / paper tools compiled out',
      'NIST 800-171 / CMMC Level 2 / ITAR / SCIF per-slice JSONL audit ledger',
      'Dedicated deployment SLA & custom model qualification',
    ],
    ctaLabel: 'Scope an Air-Gap Pilot →',
    secondary: `${GITHUB}/blob/main/docs/commercial-deployments.md`,
  },
];

const STATIC_SUBJECT: Record<string, string> = {
  sprint: 'Castor Turnkey Local Sprint',
  enterprise: 'Castor Enterprise Air-Gap Pilot',
};

/**
 * Fallback mailto bodies (calculator never touched) and dynamic bodies
 * enriched from `castor:economics-update`. Both encode with encodeURIComponent
 * so the mail client receives clean plain text.
 */
function mailtoFor(key: 'sprint' | 'enterprise', detail: null | {
  modelName: string;
  teamSize: number;
  monthlyTokensM: number;
  annualSavingsFmt: string;
  hybridMonthlyFmt: string;
}): string {
  const subject = STATIC_SUBJECT[key] ?? 'Castor';
  let body: string;

  if (detail) {
    const seats =
      key === 'enterprise'
        ? `${Math.max(10, detail.teamSize)}-seat air-gap enclave`
        : `${detail.teamSize} engineer${detail.teamSize === 1 ? '' : 's'}`;
    body =
      `Hi — I'm working through Castor's economics instrument on this page.\n\n` +
      `Workload profile: ${seats}\n` +
      `Benchmark cloud model: ${detail.modelName}\n` +
      `Monthly volume: ${detail.monthlyTokensM >= 1000 ? (detail.monthlyTokensM / 1000).toFixed(2) + 'B' : `${Math.round(detail.monthlyTokensM)}M`} tokens\n` +
      `Estimated hybrid (Castor local + cloud) spend: ${detail.hybridMonthlyFmt}/month\n` +
      `Estimated annual net savings vs. all-cloud: ${detail.annualSavingsFmt}\n\n` +
      `I'd like to scope the ${subject.replace(/^Castor /, '')} for our team. What does engagement look like?`;
  } else {
    body =
      key === 'sprint'
        ? 'Hi — we are an engineering team evaluating a one-time 48-hour local setup sprint for dedicated Castor inference hardware. What does engagement look like?'
        : 'Hi — we are evaluating a fixed-scope enterprise air-gap pilot for our regulated enclave. What does engagement look like?';
  }

  return `mailto:${EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
}
---

<section
  id="deploy"
  data-reveal
  class="scroll-mt-16 mx-auto max-w-6xl px-6 py-16 md:py-24"
>
  <header class="mb-8 max-w-3xl">
    <p class="font-mono text-[11px] uppercase tracking-widest text-ink-muted">
      {`// deploy`} · three real tiers · zero fake funnels
    </p>
    <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink md:text-4xl">
      Open Core for Engineers. Air-Gap Compliance for Regulated Teams.
    </h2>
    <p class="mt-3 text-sm leading-relaxed text-ink-secondary">
      Every path below is a real offer with a real contact — no drip forms,
      no "book a demo" theater. Your numbers from the economics instrument
      above are pre-filled into each request, so the math on the page is the
      proposal.
    </p>
  </header>

  <div class="spec-grid grid-cols-1 lg:grid-cols-3">
    {tiers.map((t) => (
      <article
        class:list={[
          'flex flex-col p-6',
          t.key === 'core' ? 'cell-recessed' : 'cell-surface',
        ]}
      >
        <header>
          <p class="font-mono text-[11px] uppercase tracking-widest text-ink-muted">
            {t.name}
          </p>
          <p class="tabular mt-2 font-display text-3xl font-bold text-ink">
            {t.price}
          </p>
          <p class="mt-1 font-mono text-[11px] text-ink-secondary">{t.tag}</p>
        </header>

        <p class="mt-4 text-xs leading-relaxed text-ink-secondary">{t.audience}</p>

        <ul class="mt-4 flex-1 space-y-2.5">
          {t.bullets.map((b) => (
            <li class="flex gap-2 text-xs leading-relaxed text-ink-secondary">
              <span
                class="mt-px shrink-0 font-mono text-[11px] text-local"
                aria-hidden="true"
              >▸</span>
              <span>{b}</span>
            </li>
          ))}
        </ul>

        <footer class="mt-auto flex flex-col gap-3 pt-8">
          {t.key === 'core' ? (
            <>
              <button
                type="button"
                class="tactile-btn tactile-btn--primary w-full"
                data-copy={`npx -y mcp-castor install --client all`}
              >
                <span class="font-mono">npx -y mcp-castor install --client all</span>
              </button>
              <a
                href={GITHUB}
                class="text-center font-mono text-[11px] leading-relaxed break-all text-ink-secondary underline decoration-hairline underline-offset-4 hover:text-ink"
              >
                {GITHUB.replace('https://', '')}
              </a>
            </>
          ) : (
            <>
              <a
                href={t.key === 'sprint' ? mailtoFor('sprint', null) : mailtoFor('enterprise', null)}
                class:list={[
                  'tactile-btn w-full',
                  t.key === 'sprint' ? 'tactile-btn--secondary' : 'tactile-btn--enterprise',
                ]}
                data-tier-cta={t.key}
              >
                {t.ctaLabel}
              </a>
              {t.secondary ? (
                <a
                  href={t.secondary}
                  class="text-center font-mono text-[11px] leading-relaxed break-all text-ink-secondary underline decoration-hairline underline-offset-4 hover:text-ink"
                >
                  Commercial deployment docs →
                </a>
              ) : null}
            </>
          )}
        </footer>
      </article>
    ))}
  </div>

  <p class="mt-4 font-mono text-[11px] text-ink-muted">
    All commercial tiers are direct from the maintainer — no reseller, no
    middleman. Questions: {EMAIL}.
  </p>
</section>

<style>
  /* Bold carbon-ink enterprise primary: deep ink on light paper, flipping
     cleanly in dark mode via the chassis variables. */
  #deploy .tactile-btn--enterprise {
    background: #101319;
    border-color: #101319;
    color: #ffffff;
  }
  #deploy .tactile-btn--enterprise:hover {
    background: #1c2230;
    border-color: #1c2230;
  }
  [data-theme='dark'] #deploy .tactile-btn--enterprise {
    background: var(--bg-instrument-raised);
    border-color: var(--bg-instrument-border);
    color: var(--ink-instrument);
  }
  [data-theme='dark'] #deploy .tactile-btn--enterprise:hover {
    background: #1a2030;
    border-color: rgba(255, 255, 255, 0.24);
  }
</style>

<script>
  import {
    ECONOMICS_UPDATE_EVENT,
    type EconomicsUpdateDetail,
  } from '../scripts/economics-calc';

  const EMAIL = 'ApatheticMioz@gmail.com';

  const STATIC_SUBJECT: Record<string, string> = {
    sprint: 'Castor Turnkey Local Sprint',
    enterprise: 'Castor Enterprise Air-Gap Pilot',
  };

  let detail: EconomicsUpdateDetail | null = null;

  function mailtoFor(
    key: 'sprint' | 'enterprise',
    d: null | EconomicsUpdateDetail,
  ): string {
    const subject = STATIC_SUBJECT[key] ?? 'Castor';
    let body: string;

    if (d) {
      const seats =
        key === 'enterprise'
          ? `${Math.max(10, d.teamSize)}-seat air-gap enclave`
          : `${d.teamSize} engineer${d.teamSize === 1 ? '' : 's'}`;
      const vol =
        d.monthlyTokensM >= 1000
          ? `${(d.monthlyTokensM / 1000).toFixed(2)}B`
          : `${Math.round(d.monthlyTokensM)}M`;
      body =
        `Hi — I'm working through Castor's economics instrument on this page.\n\n` +
        `Workload profile: ${seats}\n` +
        `Benchmark cloud model: ${d.modelName}\n` +
        `Monthly volume: ${vol} tokens\n` +
        `Estimated hybrid (Castor local + cloud) spend: ${d.hybridMonthlyFmt}/month\n` +
        `Estimated annual net savings vs. all-cloud: ${d.annualSavingsFmt}\n\n` +
        `I'd like to scope the ${subject.replace(/^Castor /, '')} for our team. What does engagement look like?`;
    } else {
      body =
        key === 'sprint'
          ? 'Hi — we are an engineering team evaluating a one-time 48-hour local setup sprint for dedicated Castor inference hardware. What does engagement look like?'
          : 'Hi — we are evaluating a fixed-scope enterprise air-gap pilot for our regulated enclave. What does engagement look like?';
    }

    return `mailto:${EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  }

  const ctaLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('#deploy [data-tier-cta]'),
  );

  function refreshCtas(): void {
    for (const link of ctaLinks) {
      const key = link.dataset.tierCta as 'sprint' | 'enterprise';
      link.href = mailtoFor(key, detail);
    }
  }

  window.addEventListener(
    ECONOMICS_UPDATE_EVENT,
    (e) => {
      const d = (e as CustomEvent<EconomicsUpdateDetail>).detail;
      if (d && d.modelName) {
        detail = d;
        refreshCtas();
      }
    },
  );

  // Initial paint (covers SSR static bodies if the calculator wasn't touched).
  refreshCtas();

  /* ── Tactile copy-to-clipboard for the install command. Real clipboard
       writes only; on non-secure contexts the hint degrades to a manual
       instruction instead of any deprecated clipboard call. ─────────── */
  const copyButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('#deploy [data-copy]'),
  );
  for (const btn of copyButtons) {
    btn.addEventListener('click', () => {
      const cmd = btn.dataset.copy ?? '';
      const labelEl = btn.querySelector<HTMLElement>('span');
      const original = labelEl?.textContent ?? '';
      const restore = () => {
        if (labelEl) {
          labelEl.textContent = original;
          labelEl.classList.remove('text-white');
        }
      };
      if (navigator.clipboard?.writeText) {
        navigator.clipboard
          .writeText(cmd)
          .then(() => {
            if (labelEl) {
              labelEl.textContent = 'COPIED ✓';
              labelEl.classList.add('text-white');
            }
            window.setTimeout(restore, 2000);
          })
          .catch(restore);
      } else {
        if (labelEl) labelEl.textContent = 'select & copy manually';
        window.setTimeout(restore, 2500);
      }
    });
  }
</script>
