---
import {
  LEDGER_76DAY,
  HARDWARE_SNAPSHOT,
  VRAM_TIERS,
  QWEN38_BENCHMARKS,
  QWEN38_MODEL_CARD_DATE,
  QWEN38_LICENSE,
} from '../data/telemetry';

const L = LEDGER_76DAY;
const H = HARDWARE_SNAPSHOT;

/** Tool execution distribution strip — shares of 63,901 sandboxed tool calls. */
const TOOL_SHARE: Array<{ name: string; pct: number }> = [
  { name: 'bash', pct: 44.0 },
  { name: 'read_file', pct: 23.8 },
  { name: 'edit_file', pct: 11.9 },
  { name: 'search_code', pct: 7.0 },
  { name: 'write_file', pct: 3.3 },
  { name: 'list_dir', pct: 3.1 },
  { name: 'web / other', pct: 6.9 },
];
const TOOL_MAX_PCT = Math.max(...TOOL_SHARE.map((t) => t.pct));

const TABS = [
  { id: 'ledger', label: '76-Day Production Ledger' },
  { id: 'live', label: 'Live vLLM 0.33.0 & Qwen3.8-27B' },
  { id: 'tiers', label: 'VRAM Hardware Tiers (8–24 GB)' },
] as const;

/**
 * Ledger 76-day 8-cell grid rows. Every headline value carries a rolling
 * odometer (`data-count-to`); the static label keeps the exact string for
 * no-JS / reduced-motion first paint, and the counter rewrites it once.
 * valueStatic doubles as the initial text — clamp sizing below keeps
 * `2,619,320,414` from clipping the right edge on 390 px viewports.
 */
const ledgerRows: Array<{
  label: string;
  value: string;
  sub: string;
  accent: '' | 'cloud' | 'local' | 'ok';
  countTo: number;
  decimals: number;
  prefix: string;
  suffix: string;
}> = [
  {
    label: 'Total Tokens Processed',
    value: L.totalTokens.toLocaleString('en-US'),
    sub: `${L.promptTokensDisplay} prompt · ${L.completionTokensDisplay} output`,
    accent: '',
    countTo: L.totalTokens,
    decimals: 0,
    prefix: '',
    suffix: '',
  },
  {
    label: 'KV Prefix Cache Hit',
    value: `${L.cacheHitPct}%`,
    sub: `${L.cachedTokensDisplay} cached prompt tokens`,
    accent: 'cloud',
    countTo: L.cacheHitPct,
    decimals: 1,
    prefix: '',
    suffix: '%',
  },
  {
    label: 'Nov Effective Prefill Avg',
    value: L.novPrefillAvgTps.toLocaleString('en-US'),
    sub: `p95 ${L.novPrefillP95Tps.toLocaleString('en-US')} · max ${L.novPrefillMaxTps.toLocaleString('en-US')}`,
    accent: '',
    countTo: L.novPrefillAvgTps,
    decimals: 0,
    prefix: '',
    suffix: ' tok/s',
  },
  {
    label: 'Nov Decode p50',
    value: `${L.novDecodeP50Tps} tok/s`,
    sub: `p95 ${L.novDecodeP95Tps} · max ${L.novDecodeMaxTps} · peak ${L.peakSpecBurstTps.toLocaleString('en-US')} DFlash2 burst`,
    accent: 'local',
    countTo: L.novDecodeP50Tps,
    decimals: 1,
    prefix: '',
    suffix: ' tok/s',
  },
  {
    label: 'Autonomous Turns',
    value: L.turns.toLocaleString('en-US'),
    sub: `${L.sessions.toLocaleString('en-US')} sessions · ${L.gpuComputeDisplay} GPU compute`,
    accent: '',
    countTo: L.turns,
    decimals: 0,
    prefix: '',
    suffix: '',
  },
  {
    label: 'Sandboxed Tool Calls',
    value: L.toolCalls.toLocaleString('en-US'),
    sub: `${L.toolSuccessPct}% success · ${L.surgicalEditRatio}× surgical edit ratio`,
    accent: '',
    countTo: L.toolCalls,
    decimals: 0,
    prefix: '',
    suffix: '',
  },
  {
    label: 'Net Savings vs Cloud',
    value: `$${L.netSavingsUsd.toLocaleString('en-US', { minimumFractionDigits: 2 })}`,
    sub: `$${L.cloudCounterfactualUsd.toLocaleString('en-US', { minimumFractionDigits: 2 })} Sonnet-tier vs $${L.electricityUsd} power · ${L.netSavingsPct}%`,
    accent: 'ok',
    countTo: L.netSavingsUsd,
    decimals: 2,
    prefix: '$',
    suffix: '',
  },
  {
    label: 'Live RTX 3090 VRAM',
    value: H.gpu.vramUsedMiB.toLocaleString('en-US'),
    sub: `${H.gpu.vramTotalMiB.toLocaleString('en-US')} MiB total · ${H.gpu.powerDrawW} W · ${H.gpu.tempC} °C`,
    accent: 'local',
    countTo: H.gpu.vramUsedMiB,
    decimals: 0,
    prefix: '',
    suffix: ' MiB',
  },
];

const accentClass: Record<string, string> = {
  '': 'text-ink',
  cloud: 'text-cloud',
  local: 'text-local',
  ok: 'text-ok',
};

/** Live snapshot 8-cell grid rows. */
const liveRows: Array<[string, string, string]> = [
  ['Live Prefix Hit (vLLM /metrics)', '92.6%', 'per-request, Nov 19 live'],
  ['MTP Draft Acceptance', '70.5%', 'across 16,589 drafts'],
  ['Mean Tokens per Draft', '3.45', 'MTP acceptance length'],
  ['Avg Time to First Token', '3.22 s', 'live /metrics'],
  ['KV Pool', '150,000', 'tokens · max_model_len'],
  ['Model', 'Qwen3.8-27B-W4A16-AutoRound-fast', `${QWEN38_LICENSE} · card ${QWEN38_MODEL_CARD_DATE}`],
  ['GPU (nvidia-smi)', 'RTX 3090 · 23,869 / 24,576 MiB', `${H.gpu.powerDrawW} W · ${H.gpu.tempC} °C`],
  ['Driver / Engine', '616.92 · vLLM 0.33.0', `snapshot ${H.asOf}`],
];

/** Qwen3.8-27B vendor benchmark bars, descending. */
const qwenBars: Array<{ suite: string; score: number }> = [...QWEN38_BENCHMARKS].sort(
  (a, b) => b.score - a.score,
);
---

<section id="telemetry" data-reveal class="scroll-mt-16 border-y border-hairline bg-recessed/40">
  <!-- Architectural bar -->
  <div class="border-b border-hairline">
    <div class="mx-auto max-w-6xl px-4 py-5 sm:px-6">
      <div class="flex flex-col gap-1">
        <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          Measured Silicon. Zero Marketing Math.
        </h2>
        <p class="font-mono text-xs text-ink-muted">
          Source: <span class="text-ink-secondary">./target/release/castor stats</span> · Sep 4 –
          Nov 19, 2026 · 1× RTX 3090
        </p>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
    <!-- 3-tab hardware switchbank: active tab raised on pure surface with a
         2px signal bar; inactive tabs sit recessed on the hairline grid. -->
    <div
      role="tablist"
      aria-label="Hardware telemetry views"
      class="spec-grid grid-cols-1 md:grid-cols-3"
    >
      {TABS.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${t.id}`}
          aria-controls={`panel-${t.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? '0' : '-1'}
          class={`sl-tab px-4 py-3 text-left ${i === 0 ? 'is-active' : ''}`}
        >
          {t.label}
        </button>
      ))}
    </div>

    <!-- Tab 1 · 76-day production ledger -->
    <div
      role="tabpanel"
      id="panel-ledger"
      aria-labelledby="tab-ledger"
      class="sl-panel mt-6"
    >
      <div class="spec-grid grid-cols-2 lg:grid-cols-4">
        {ledgerRows.map((row) => (
          <div class="p-4">
            <p class="font-mono text-[11px] uppercase tracking-widest text-ink-muted">{row.label}</p>
            <p
              class={`tabular mt-2 break-words font-display text-[clamp(1.0rem,4.1vw,1.65rem)] font-bold leading-none tracking-tight ${accentClass[row.accent]}`}
              data-count-to={row.countTo}
              data-decimals={row.decimals}
              data-prefix={row.prefix}
              data-suffix={row.suffix}
            >
              {row.value}
            </p>
            <p class="tabular mt-1 font-mono text-[11px] leading-relaxed text-ink-secondary">
              {row.sub}
            </p>
          </div>
        ))}
      </div>

      <!-- Tool execution distribution strip: 7 bars animate scaleX(0)→1 -->
      <div class="mt-px border border-hairline bg-surface p-4">
        <p class="font-mono text-[11px] uppercase tracking-widest text-ink-muted">
          Tool Execution Distribution · <span class="tabular text-ink-secondary">63,901</span> sandboxed calls
        </p>
        <div class="mt-3 space-y-2">
          {TOOL_SHARE.map((t) => (
            <div class="flex items-center gap-3">
              <span class="tabular w-28 shrink-0 text-right font-mono text-[11px] text-ink-secondary sm:w-36">
                {t.name}
              </span>
              <span class="h-2 flex-1 bg-recessed">
                <span
                  class="sl-toolbar block h-2 bg-local"
                  data-bar-width={`${((t.pct / TOOL_MAX_PCT) * 100).toFixed(2)}`}
                ></span>
              </span>
              <span class="tabular w-12 shrink-0 text-right font-mono text-[11px] text-ink">
                {t.pct.toFixed(1)}%
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Tab 2 · Live vLLM 0.33.0 & Qwen3.8-27B -->
    <div
      role="tabpanel"
      id="panel-live"
      aria-labelledby="tab-live"
      hidden
      class="sl-panel mt-6"
    >
      <div class="spec-grid grid-cols-2 lg:grid-cols-4">
        {liveRows.map((row, i) => (
          <div class="p-4">
            <p class="font-mono text-[11px] uppercase tracking-widest text-ink-muted">{row[0]}</p>
            <p
              class={`tabular mt-2 break-words font-display text-[clamp(0.9rem,4.1vw,1.375rem)] font-bold leading-tight tracking-tight ${
                i === 0
                  ? 'text-cloud'
                  : i === 1 || i === 2
                    ? 'text-local'
                    : 'text-ink'
              }`}
            >
              {row[1]}
            </p>
            <p class="tabular mt-1 font-mono text-[11px] leading-relaxed text-ink-secondary">
              {row[2]}
            </p>
          </div>
        ))}
      </div>

      <!-- Qwen3.8-27B benchmark bar panel -->
      <div class="mt-px border border-hairline bg-surface p-4">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <p class="font-mono text-[11px] uppercase tracking-widest text-ink-muted">
            Qwen3.8-27B · Verified Vendor Benchmarks
          </p>
          <p class="font-mono text-[11px] text-ink-muted">
            Hugging Face official model card · {QWEN38_MODEL_CARD_DATE} · {QWEN38_LICENSE}
          </p>
        </div>
        <div class="mt-3 space-y-2">
          {qwenBars.map((b) => (
            <div class="flex items-center gap-3">
              <span class="tabular w-28 shrink-0 text-right font-mono text-[11px] text-ink-secondary sm:w-36">
                {b.suite}
              </span>
              <span class="h-2 flex-1 bg-recessed">
                <span
                  class="sl-toolbar block h-2 bg-cloud"
                  data-bar-width={b.score.toFixed(2)}
                ></span>
              </span>
              <span class="tabular w-12 shrink-0 text-right font-mono text-[11px] text-ink">
                {b.score.toFixed(1)}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Tab 3 · VRAM hardware tiers -->
    <div role="tabpanel" id="panel-tiers" aria-labelledby="tab-tiers" hidden class="sl-panel mt-6">
      <div class="spec-grid">
        <div class="col-span-2 bg-recessed px-4 py-3 lg:col-span-4">
          <div class="grid grid-cols-2 gap-x-4 font-mono text-[11px] uppercase tracking-widest text-ink-muted lg:grid-cols-4">
            <span>VRAM Tier</span>
            <span>Engine</span>
            <span>Context</span>
            <span>Decode</span>
          </div>
        </div>
        {VRAM_TIERS.map((t) => (
          <div class={`col-span-2 px-4 py-3 lg:col-span-4 ${t.highlight ? 'cell-raised' : ''}`}>
            <div
              class={`grid grid-cols-2 gap-x-4 lg:grid-cols-4 ${
                t.highlight ? 'border-l-2 border-l-[var(--signal-local)] pl-3' : ''
              }`}
            >
              <p class={`font-mono text-sm ${t.highlight ? 'font-semibold text-local' : 'text-ink'}`}>
                {t.vram}
              </p>
              <p class="font-mono text-xs leading-relaxed text-ink-secondary">{t.engine}</p>
              <p class="tabular font-mono text-xs leading-relaxed text-ink-secondary">
                {t.context}
              </p>
              <p class="tabular font-mono text-xs leading-relaxed text-ink-secondary">
                {t.decode}
              </p>
            </div>
          </div>
        ))}
      </div>
      <p class="mt-3 font-mono text-[11px] text-ink-muted">
        Consumer laptop to 24 GB workstation: the same zero-egress microkernel, from
        <span class="text-ink-secondary"> llama.cpp + Ternary-Bonsai / DFlash2 </span>
        up to
        <span class="text-ink-secondary"> vLLM 0.33.0 MTP Swarm</span>.
      </p>
    </div>
  </div>
</section>

<style>
  /* 3-tab hardware switchbank: recessed track, one raised active tab with
     a 2px top signal bar (Cobalt default, Orange for the live engine tab). */
  .sl-tab {
    position: relative;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--bg-recessed);
    color: var(--ink-muted);
    border: 0;
    transition: background-color 120ms linear, color 120ms linear;
  }
  .sl-tab:hover {
    color: var(--ink-secondary);
  }
  .sl-tab.is-active {
    background: var(--bg-surface);
    color: var(--ink-primary);
  }
  .sl-tab.is-active::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--signal-cloud);
  }
  [id='tab-live'].is-active::before {
    background: var(--signal-local);
  }

  /* Tool-distribution bars: rest at full width in CSS-free HTML output,
     the script pre-scales them to 0 and animates to data-bar-width on
     viewport entry (instant under reduced motion). */
  .sl-toolbar {
    display: block;
    width: var(--bar-final, 100%);
    height: 100%;
    transform: scaleX(var(--bar-scale, 1));
    transform-origin: left center;
  }
  .sl-toolbar.is-armed {
    transform: scaleX(0);
  }
  .sl-toolbar.is-grown {
    transform: scaleX(1);
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--bar-delay, 0ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .sl-tab,
    .sl-toolbar {
      transition: none;
    }
  }
</style>

<script src="../scripts/spec-ledger.ts"></script>
