---
import { HARDWARE_SNAPSHOT, formatInt } from '../data/telemetry';

const { gpu } = HARDWARE_SNAPSHOT;

/**
 * OLED mode switchbank. Colors are hardware constants — the instrument
 * surface stays dark in both the paper and obsidian chassis themes, so the
 * switch uses OLED signal tokens (`--signal-cloud-oled` / `--signal-local-oled`
 * / `--ink-instrument`) and is deliberately theme-constant.
 */
const MODES: Array<{ id: string; label: string; sub: string; accent: string }> = [
  { id: 'warm', label: 'Warm KV Prefill', sub: '93.7% hit', accent: 'var(--signal-cloud-oled)' },
  { id: 'mtp', label: 'MTP Speculative Decode', sub: '70.5% accept', accent: 'var(--signal-local-oled)' },
  { id: 'swarm', label: '4× Swarm Concurrency', sub: 'MAX_SEQS=4', accent: 'var(--ink-instrument)' },
];

/** 48-cell VRAM KV-cache memory matrix — one hardware LED block per cell. */
const KV_CELLS = Array.from({ length: 48 }, (_, i) => i);
---

<div
  id="live-engine"
  class="instrument-chassis min-w-0 max-w-full overflow-x-clip"
  role="region"
  aria-label="Live bench: Qwen3.8-27B on RTX 3090 (vLLM 0.33.0)"
>
  <!-- Instrument bezel bar: status LED, rig line, REPLAY + PAUSE/RESUME keys -->
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-[var(--bg-instrument-border)] px-3 py-2.5 sm:px-4">
    <span class="relative flex h-1.5 w-1.5 shrink-0" aria-hidden="true">
      <span class="led-live absolute inset-0 animate-pulse rounded-full bg-[#22C55E]"></span>
    </span>
    <p
      class="min-w-0 flex-1 truncate font-mono text-[11px] uppercase tracking-[0.12em] text-[#8C95A6]"
    >
      LIVE BENCH · RTX 3090 (24 GB) · vLLM 0.33.0 · QWEN3.8-27B-W4A16
    </p>
    <button
      type="button"
      id="engine-replay"
      class="les-key shrink-0 px-2.5 py-1 font-mono text-[11px] uppercase tracking-[0.1em]"
      aria-label="Replay: restart a fresh streaming dispatch burst"
    >
      REPLAY
    </button>
    <button
      type="button"
      id="engine-pause"
      aria-pressed="false"
      class="les-key shrink-0 px-2.5 py-1 font-mono text-[11px] uppercase tracking-[0.1em]"
    >
      <span data-pause-label>PAUSE</span>
      <span data-resume-label class="text-[#F97316]" style="display: none;">RESUME</span>
    </button>
  </div>

  <!-- 3-mode OLED switchbank: strict single active 2px top bar ([aria-selected]) -->
  <div class="les-bank grid grid-cols-1 gap-[2px] px-2 pt-2 sm:grid-cols-3" role="tablist" aria-label="Simulation mode">
    {MODES.map((m, i) => (
      <button
        type="button"
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        class={`les-mode min-w-0 ${i === 0 ? 'is-active' : ''}`}
        data-mode={m.id}
        style={`--mode-accent: ${m.accent};`}
      >
        <span class="block font-mono text-[12px] uppercase tracking-[0.08em]">{m.label}</span>
        <span class="mt-0.5 block font-mono text-[10px] text-[#8C95A6]">{m.sub}</span>
      </button>
    ))}
  </div>

  <!-- 4-cell 10Hz tabular OLED readout strip: 2×2 on mobile, 4-across from sm -->
  <div class="grid grid-cols-2 border-y border-[var(--bg-instrument-border)] sm:grid-cols-4">
    <div class="min-w-0 border-r border-b border-[var(--bg-instrument-border)] px-3 py-2.5 sm:border-b-0 sm:px-4">
      <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-[#8C95A6]">PREFILL VELOCITY</p>
      <p class="tabular mt-1 font-display text-lg font-bold leading-none text-[#3B82F6] sm:text-xl">
        <span id="td-prefill">0</span>
        <span class="ml-1 font-mono text-[10px] font-normal text-[#8C95A6]">tok/s</span>
      </p>
    </div>
    <div class="min-w-0 border-b border-[var(--bg-instrument-border)] px-3 py-2.5 sm:border-b-0 sm:px-4">
      <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-[#8C95A6]">DECODE RATE</p>
      <p class="tabular mt-1 font-display text-lg font-bold leading-none text-[#F97316] sm:text-xl">
        <span id="td-decode">0.0</span>
        <span class="ml-1 font-mono text-[10px] font-normal text-[#8C95A6]">tok/s</span>
      </p>
    </div>
    <div class="min-w-0 border-r border-[var(--bg-instrument-border)] px-3 py-2.5 sm:px-4">
      <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-[#8C95A6]">KV CACHE HIT</p>
      <p class="tabular mt-1 font-display text-lg font-bold leading-none text-[#3B82F6] sm:text-xl">
        <span id="td-kvhit">0.0</span>
        <span class="ml-1 font-mono text-[10px] font-normal text-[#8C95A6]">%</span>
      </p>
    </div>
    <div class="min-w-0 px-3 py-2.5 sm:px-4">
      <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-[#8C95A6]">SESSION COST</p>
      <p class="tabular mt-1 font-mono text-sm leading-none text-[#22C55E]">$0.000</p>
      <p class="tabular mt-1 font-mono text-[10px] leading-none text-[#8C95A6]">
        cloud cf <span id="td-cloudcost">$0.000</span>
      </p>
    </div>
  </div>

  <!-- Live 48-block VRAM KV-cache memory matrix -->
  <div class="px-3 pt-2.5 sm:px-4">
    <p class="mb-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[10px] uppercase tracking-[0.1em] text-[#8C95A6]">
      <span class="text-[#F3F5F8]">KV POOL 150K</span>
      <span class="flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 bg-[#3B82F6]" aria-hidden="true"></span> REUSED PREFIX
      </span>
      <span class="flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 bg-[#F97316]" aria-hidden="true"></span> ACTIVE DECODE
      </span>
      <span class="flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 bg-[var(--bg-instrument-raised)]" aria-hidden="true"></span> FREE
      </span>
    </p>
    <div
      id="engine-kv-blocks"
      class="grid grid-cols-24 gap-[2px] sm:grid-cols-48"
      aria-hidden="true"
    >
      {KV_CELLS.map((i) => (
        <span class="les-kv h-[3px] bg-[var(--bg-instrument-raised)]" data-idx={i}></span>
      ))}
    </div>
  </div>

  <!-- Canvas 2D oscilloscope: explicit non-zero-height wrapper -->
  <div class="mt-2 h-[190px] w-full sm:h-[225px]">
    <canvas
      id="engine-scope"
      class="block h-full w-full"
      aria-hidden="true"
    ></canvas>
  </div>

  <!-- Upgraded live-streaming MCP protocol console (5 crisp mono lines) -->
  <div class="overflow-hidden border-y border-[var(--bg-instrument-border)] px-3 py-2.5 sm:px-4">
    <div
      id="engine-console"
      class="flex h-[105px] flex-col justify-end overflow-hidden font-mono text-[11px] leading-[21px] sm:text-[12px]"
      aria-live="polite"
    ></div>
  </div>

  <!-- nvidia-smi status footer: flex-wrap, zero horizontal scrollbar at 390px -->
  <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 px-3 py-2 sm:px-4">
    <p class="tabular font-mono text-[10px] uppercase tracking-[0.08em] text-[#8C95A6]">
      GPU: {formatInt(gpu.vramUsedMiB)} / {formatInt(gpu.vramTotalMiB)} MiB
      <span class="text-[#646D7D]">· {gpu.powerDrawW} W · {gpu.tempC} °C</span>
    </p>
    <p class="tabular font-mono text-[10px] uppercase tracking-[0.08em] text-[#646D7D]">
      DRIVER {gpu.driver}
    </p>
  </div>
</div>

<style>
  /* ── OLED hardware keys (REPLAY / PAUSE) ────────────────────────────
     Machined dark keys on the instrument surface. Theme-constant: the
     chassis never changes with the page theme. */
  .les-key {
    border: 1px solid var(--bg-instrument-border);
    background: var(--bg-instrument-raised);
    color: var(--ink-instrument);
    border-radius: 3px;
    transition: border-color 120ms linear, background-color 120ms linear;
  }
  .les-key:hover {
    border-color: rgba(255, 255, 255, 0.3);
  }
  .les-key:active {
    background: #1a202e;
    transform: translateY(1px);
  }

  /* ── Mode switchbank: strict single active 2px top bar ────────────── */
  .les-mode {
    position: relative;
    background: var(--bg-instrument-raised);
    border: 1px solid var(--bg-instrument-border);
    color: var(--ink-instrument-muted);
    padding: 10px 12px;
    text-align: left;
    cursor: pointer;
    transition: background-color 120ms linear, border-color 120ms linear, color 120ms linear;
  }
  .les-mode:hover {
    border-color: rgba(255, 255, 255, 0.22);
    color: var(--ink-instrument);
  }
  .les-mode[aria-selected='true'] {
    background: var(--bg-instrument);
    border-color: var(--bg-instrument-border);
    color: var(--ink-instrument);
  }
  .les-mode[aria-selected='true']::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    height: 2px;
    background: var(--mode-accent, var(--signal-cloud-oled));
  }

  /* ── 48-cell KV matrix LED blocks (JS swaps these classes at 10 Hz) ─ */
  .les-kv {
    transition: background-color 140ms linear;
  }
  .les-kv.is-cobalt {
    background: #3b82f6;
  }
  .les-kv.is-amber {
    background: #f97316;
  }
  /* .is-free leaves the base --bg-instrument-raised color untouched */

  /* ── Console line colors (OLED signal palette, theme-constant) ────── */
  #engine-console .t-cloud {
    color: var(--signal-cloud-oled);
  }
  #engine-console .t-local {
    color: var(--signal-local-oled);
  }
  #engine-console .t-muted {
    color: var(--ink-instrument-muted);
  }
  #engine-console .t-ink {
    color: var(--ink-instrument);
  }
  #engine-console .c-cursor {
    color: var(--signal-local-oled);
    animation: les-blink 1.06s steps(1) infinite;
  }
  @keyframes les-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .led-live,
    .les-mode,
    .les-key,
    .les-kv,
    .c-cursor {
      animation: none !important;
      transition: none !important;
    }
    .les-key:active {
      transform: none;
    }
  }
</style>

<script>
  import '../scripts/live-engine';
</script>
