---
/**
 * Castor — November 2026 Economics Instrument (Swiss Industrial Paper)
 * Crisp `bg-surface` financial-instrument chassis with 1px inner dividers,
 * one-click workload preset chips, rAF-eased numeric readouts, and a live
 * `castor:economics-update` conversion hook for the DeploymentTiers CTAs.
 * Server-renders the 5-Eng Startup preset default; hydrates via the shared
 * `economics-calc` engine for live recomputation.
 */
import { CLOUD_MODELS, CLOUD_MODELS_VERIFIED_ON, type CloudModel } from '../data/telemetry';
import {
  computeEconomics,
  fmtUsd,
  fmtUsdCompact,
  fmtKwh,
  fmtPayback,
  fmtTokensM,
  PROMPT_SHARE,
  OUTPUT_SHARE,
  KWH_PER_1B_TOKENS,
  USED_RTX3090_USD,
  ENGINEERS_PER_NODE,
  type CalcInputs,
  type CalcOutputs,
} from '../scripts/economics-calc';

const DEFAULT_MODEL_INDEX = 4; // Claude Sonnet 5.5 — 5-Eng Startup preset default

const PRESETS = [
  { key: 'solo', label: 'Solo Dev · 1× 3090', team: 1, volume: 200, offload: 90, rate: 0.18 },
  { key: 'startup', label: '5-Eng Startup', team: 5, volume: 150, offload: 85, rate: 0.18 },
  { key: 'enclave', label: '25-Seat Air-Gap Enclave', team: 25, volume: 180, offload: 90, rate: 0.14 },
];
const DEFAULT_PRESET_KEY = 'startup';

function priceLabel(m: CloudModel): string {
  const f = (n: number) => (n < 1 ? n.toFixed(2) : n.toString());
  return `$${f(m.priceInPer1m)}/$${f(m.priceOutPer1m)}`;
}

/**
 * Balanced one-line subtext for a model button. The separator `·` is only
 * rendered between pieces that actually exist — so models with neither an
 * AA score nor a note (Claude Sonnet 5.5, GPT-6.2 Sol) never show a dangling
 * trailing ` · `. Rate-like notes (containing "$") replace the base rate;
 * short tags (e.g. "Standard", "Budget") append after it.
 */
function subLabel(m: CloudModel): string {
  if (m.aaScore) return `${priceLabel(m)} / 1M · AA ${m.aaScore}`;
  if (m.priceNote) {
    return m.priceNote.includes('$')
      ? m.priceNote
      : `${priceLabel(m)} / 1M · ${m.priceNote}`;
  }
  return `${priceLabel(m)} / 1M`;
}

const preset = PRESETS.find((p) => p.key === DEFAULT_PRESET_KEY)!;

const INITIAL: CalcInputs = {
  model: CLOUD_MODELS[DEFAULT_MODEL_INDEX],
  teamSize: preset.team,
  tokensPerEngineerM: preset.volume,
  localOffloadPct: preset.offload,
  electricityRate: preset.rate,
  useRealAgenticCache: true,
};
const O: CalcOutputs = computeEconomics(INITIAL);
const hybridCloudPct = (O.hybridCloudUsd / O.cloudOnlyUsd) * 100;
const hybridLocalPct = (O.hybridLocalUsd / O.cloudOnlyUsd) * 100;
const isHaiku = INITIAL.model.name === 'Claude Haiku 5.5';

const teamReadout =
  INITIAL.teamSize === 1 ? '1 engineer' : `${INITIAL.teamSize} engineers`;
---

<section
  id="economics"
  data-reveal
  class="scroll-mt-16 mx-auto max-w-6xl px-6 py-16 md:py-24"
>
  <header class="mb-8 max-w-3xl">
    <p class="font-mono text-[11px] uppercase tracking-widest text-ink-muted">
      {`// economics`} · rates verified {CLOUD_MODELS_VERIFIED_ON}
    </p>
    <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink md:text-4xl">
      Tier-Keyed November 2026 Economics.
    </h2>
    <p class="mt-3 text-sm leading-relaxed text-ink-secondary">
      Every figure below is computed live against verified official frontier
      API pricing — all tiers, not just the flagship. Pick your workload
      preset or drag the sliders to your team's actual volume and watch the
      math.
    </p>
  </header>

  <div class="border border-hairline bg-surface">
    <!-- ── Left: Presets + Controls ─────────────────────────────────── -->
    <div
      class="border-b border-hairline p-6 lg:border-b-0 lg:border-r"
      role="region"
      aria-label="Economics model controls"
    >
      <h3 class="font-mono text-[11px] uppercase tracking-widest text-ink-muted">
        Workload Presets
      </h3>
      <div
        role="group"
        aria-label="One-click workload presets"
        class="mt-3 flex flex-wrap gap-2"
      >
        {PRESETS.map((p) => (
          <button
            type="button"
            aria-pressed={p.key === DEFAULT_PRESET_KEY ? 'true' : 'false'}
            data-preset-key={p.key}
            class:list={[
              'tactile-key px-3 py-2 font-mono text-[11px] leading-snug',
              p.key === DEFAULT_PRESET_KEY ? 'tactile-key--local is-pressed text-ink' : 'text-ink-secondary',
            ]}
          >
            {p.label}
          </button>
        ))}
      </div>

      <h3 class="mt-8 font-mono text-[11px] uppercase tracking-widest text-ink-muted">
        Cloud Frontier Model
      </h3>
      <div
        role="radiogroup"
        aria-label="Cloud frontier model"
        class="mt-3 grid grid-cols-1 gap-1 sm:grid-cols-2"
      >
        {CLOUD_MODELS.map((m, i) => (
          <button
            type="button"
            role="radio"
            aria-checked={i === DEFAULT_MODEL_INDEX ? 'true' : 'false'}
            data-model-index={i}
            class:list={[
              'tactile-key tactile-key--cloud flex flex-col justify-center px-3 py-2 text-left',
              i === DEFAULT_MODEL_INDEX && 'is-pressed',
            ]}
          >
            <span class="block font-mono text-xs text-ink">
              {m.name}
              {m.note ? <span class="text-ink-muted"> · {m.note}</span> : null}
            </span>
            <span class="tabular mt-1 block font-mono text-[11px] leading-snug text-ink-secondary">
              {subLabel(m)}
            </span>
          </button>
        ))}
      </div>

      <h3 class="mt-8 font-mono text-[11px] uppercase tracking-widest text-ink-muted">
        Hardware & Workload
      </h3>

      <div class="mt-4 space-y-5">
        <div>
          <div class="flex items-baseline justify-between">
            <label for="ec-team" class="font-mono text-xs text-ink-secondary">
              TEAM SIZE
            </label>
            <output id="ec-team-readout" class="tabular font-mono text-xs text-ink">
              {teamReadout}
            </output>
          </div>
          <input
            id="ec-team"
            type="range"
            min="1"
            max="100"
            step="1"
            value={preset.team}
            data-param="teamSize"
            data-readout="ec-team-readout"
            aria-label="Team size in engineers, 1 to 100"
          />
        </div>

        <div>
          <div class="flex items-baseline justify-between">
            <label for="ec-volume" class="font-mono text-xs text-ink-secondary">
              MONTHLY VOLUME / ENGINEER
            </label>
            <output id="ec-volume-readout" class="tabular font-mono text-xs text-ink">
              {`${preset.volume}M tokens / mo`}
            </output>
          </div>
          <input
            id="ec-volume"
            type="range"
            min="20"
            max="500"
            step="10"
            value={preset.volume}
            data-param="tokensPerEngineerM"
            data-readout="ec-volume-readout"
            aria-label="Monthly token volume per engineer, 20 million to 500 million, in 10 million increments"
          />
        </div>

        <div>
          <div class="flex items-baseline justify-between">
            <label for="ec-offload" class="font-mono text-xs text-ink-secondary">
              LOCAL OFFLOAD SHARE
            </label>
            <output id="ec-offload-readout" class="tabular font-mono text-xs text-local">
              {`${preset.offload}% on local silicon`}
            </output>
          </div>
          <input
            id="ec-offload"
            type="range"
            min="50"
            max="95"
            step="5"
            value={preset.offload}
            data-param="localOffloadPct"
            data-readout="ec-offload-readout"
            aria-label="Share of tokens served by local silicon, 50% to 95%, in 5% increments"
          />
        </div>

        <div>
          <div class="flex items-baseline justify-between">
            <label for="ec-rate" class="font-mono text-xs text-ink-secondary">
              ELECTRICITY RATE
            </label>
            <output id="ec-rate-readout" class="tabular font-mono text-xs text-ink">
              {`$${preset.rate.toFixed(2)}/kWh`}
            </output>
          </div>
          <input
            id="ec-rate"
            type="range"
            min="0.1"
            max="0.35"
            step="0.01"
            value={preset.rate}
            data-param="electricityRate"
            data-readout="ec-rate-readout"
            aria-label="Electricity rate, 10 to 35 cents per kilowatt hour"
          />
        </div>
      </div>

      <p class="mt-6 font-mono text-[11px] leading-relaxed text-ink-muted">
        Local energy intensity: {KWH_PER_1B_TOKENS} kWh per 1B tokens, measured
        at ~250 W on an RTX 3090 (52.1 kWh / 2.62B tokens, 76-day ledger).
        Node hardware: {fmtUsd(USED_RTX3090_USD)} used RTX 3090 per
        {ENGINEERS_PER_NODE}-engineer node.
      </p>
    </div>

    <!-- ── Right: Live Calculated Ledger ────────────────────────────── -->
    <div class="p-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h3 class="font-mono text-[11px] uppercase tracking-widest text-ink-muted">
          Live Calculated Ledger
        </h3>
        <div
          role="radiogroup"
          aria-label="Prompt cache assumption"
          class="flex gap-1"
        >
          <button
            type="button"
            role="radio"
            aria-checked="true"
            data-cache="real"
            class="tactile-key tactile-key--cloud px-3 py-1.5 font-mono text-[11px] text-ink is-pressed"
          >
            REAL AGENTIC · 70% CACHE DISC.
          </button>
          <button
            type="button"
            role="radio"
            aria-checked="false"
            data-cache="list"
            class="tactile-key px-3 py-1.5 font-mono text-[11px] text-ink-secondary"
          >
            LIST API RATE
          </button>
        </div>
      </div>

      <p class="tabular mt-3 font-mono text-[11px] text-ink-secondary" data-assumptions>
        {`${INITIAL.teamSize} engineer${INITIAL.teamSize === 1 ? '' : 's'} × ${INITIAL.tokensPerEngineerM}M = ${fmtTokensM(O.totalTokensM)} tokens/mo · ${PROMPT_SHARE * 100}% prompt / ${OUTPUT_SHARE * 100}% output · effective ${fmtUsd(O.costPerM, 2)}/1M${INITIAL.useRealAgenticCache ? ' (70% cached)' : ' (uncached)'}`}
      </p>

      <div class="spec-grid mt-5 grid-cols-2" data-ledger>
        <div class="cell-recessed p-4">
          <p class="font-mono text-[11px] uppercase tracking-widest text-ink-muted">
            Cloud-Only / Month
          </p>
          <p class="tabular font-display text-2xl font-bold text-cloud md:text-3xl" data-cell="cloudOnly">
            {fmtUsdCompact(O.cloudOnlyUsd)}
          </p>
          <p class="tabular font-mono text-[11px] text-ink-secondary" data-cellSub="cloudOnly">
            {fmtUsd(O.cloudOnlyUsd)} list-equivalent
          </p>
        </div>
        <div class="cell-recessed p-4">
          <p class="font-mono text-[11px] uppercase tracking-widest text-ink-muted">
            Castor Hybrid / Month
          </p>
          <p class="tabular font-display text-2xl font-bold text-local md:text-3xl" data-cell="hybrid">
            {fmtUsdCompact(O.hybridTotalUsd)}
          </p>
          <p class="tabular font-mono text-[11px] text-ink-secondary" data-cellSub="hybrid">
            {fmtUsd(O.hybridCloudUsd)} cloud + {fmtKwh(O.hybridLocalKwh)}
          </p>
        </div>
        <div class="p-4">
          <p class="font-mono text-[11px] uppercase tracking-widest text-ink-muted">
            Annual Net Savings
          </p>
          <div class="border-b-2 border-b-[var(--signal-local)] pb-2">
            <p
              class="tabular font-display text-2xl font-bold leading-none text-[var(--signal-local)] md:text-3xl"
              data-cell="annual"
            >
              {fmtUsdCompact(O.annualSavingsUsd)}
            </p>
          </div>
          <p class="tabular mt-2.5 font-mono text-[11px] text-ink-secondary" data-cellSub="annual">
            {fmtUsd(O.monthlySavingsUsd)}/mo × 12
          </p>
        </div>
        <div class="p-4">
          <p class="font-mono text-[11px] uppercase tracking-widest text-ink-muted">
            RTX 3090 Payback
          </p>
          <p class="tabular font-display text-2xl font-bold text-ink md:text-3xl" data-cell="payback">
            {fmtPayback(O.paybackMonths)}
          </p>
          <p class="tabular font-mono text-[11px] text-ink-secondary" data-cellSub="payback">
            {O.nodes} node{O.nodes === 1 ? '' : 's'} · {fmtUsd(O.hardwareCostUsd)} hardware
          </p>
        </div>
      </div>

      <!-- Stacked comparison bars: cloud-only full scale vs hybrid slices -->
      <div class="mt-6 space-y-4" data-bars>
        <div>
          <div class="flex items-baseline justify-between font-mono text-[11px]">
            <span class="text-ink-secondary">CLOUD-ONLY</span>
            <span class="tabular text-ink" data-barLabel="cloudOnly">
              {fmtUsdCompact(O.cloudOnlyUsd)}
            </span>
          </div>
          <div class="mt-1 h-4 w-full bg-recessed">
            <div
              class="h-full bg-cloud transition-[width] duration-300 ease-out"
              style="width: 100%;"
              data-bar="cloudOnly"
            ></div>
          </div>
        </div>
        <div>
          <div class="flex items-baseline justify-between font-mono text-[11px]">
            <span class="text-ink-secondary">CASTOR HYBRID</span>
            <span class="tabular text-local" data-barLabel="hybrid">
              {fmtUsdCompact(O.hybridTotalUsd)}
            </span>
          </div>
          <div class="mt-1 flex h-4 w-full bg-recessed">
            <div
              class="h-full bg-cloud transition-[width] duration-300 ease-out"
              style={`width: ${hybridCloudPct.toFixed(2)}%;`}
              data-bar="hybridCloud"
            ></div>
            <div
              class="h-full bg-local transition-[width] duration-300 ease-out"
              style={`width: ${hybridLocalPct.toFixed(2)}%;`}
              data-bar="hybridLocal"
            ></div>
          </div>
          <div class="mt-1 flex gap-4 font-mono text-[10px] text-ink-muted">
            <span><span class="text-cloud">■</span> cloud lead slice</span>
            <span><span class="text-local">■</span> local electricity</span>
          </div>
        </div>
      </div>

      <div
        id="ec-haiku-note"
        class="mt-6 border-l-2 border-local bg-local-dim p-4"
        class:list={[isHaiku ? '' : 'hidden']}
      >
        <p class="font-mono text-[11px] font-semibold uppercase tracking-widest text-local">
          Why teams still deploy Castor at the $0.25/$1.25 tier
        </p>
        <p class="mt-2 text-xs leading-relaxed text-ink-secondary">
          Ultra-cheap cloud rates compress raw token arbitrage. At this tier,
          Castor is deployed for zero-egress air-gap compliance, deterministic
          AST gating before any edit commits, and unlimited local concurrency
          that no API rate limit touches.
        </p>
      </div>

      <p class="mt-6 border-t border-hairline pt-4 font-mono text-[11px] leading-relaxed text-ink-muted">
        Rates verified Nov 16, 2026 from Anthropic, OpenAI, and Google official
        docs. Gemini 4 Carbon/Argon intro $2/$10 ends Nov 30, 2026
        ($4/$20 standard Dec 1). Energy intensity calibrated to Castor's
        76-day RTX 3090 ledger (52.1 kWh / 2.62B tokens).
      </p>
    </div>
  </div>

  <style>
    /* Swiss tactile sliders: thin graphite track, 14px International Orange
       square thumb. All colors ride the chassis variables so the control
       reads correctly in dark obsidian mode too. */
    #economics input[type='range'] {
      -webkit-appearance: none;
      appearance: none;
      width: 100%;
      height: 14px;
      margin-top: 4px;
      background: transparent;
      cursor: pointer;
    }
    #economics input[type='range']::-webkit-slider-runnable-track {
      height: 2px;
      background: var(--border-strong);
      border: none;
      border-radius: 0;
    }
    #economics input[type='range']::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 14px;
      height: 14px;
      margin-top: -6px;
      background: var(--signal-local);
      border: none;
      border-radius: 0;
      transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    #economics input[type='range']:hover::-webkit-slider-thumb {
      transform: scale(1.15);
    }
    #economics input[type='range']:focus-visible::-webkit-slider-thumb {
      outline: 2px solid var(--signal-local);
      outline-offset: 3px;
    }
    #economics input[type='range']::-moz-range-track {
      height: 2px;
      background: var(--border-strong);
      border: none;
      border-radius: 0;
    }
    #economics input[type='range']::-moz-range-thumb {
      width: 14px;
      height: 14px;
      background: var(--signal-local);
      border: none;
      border-radius: 0;
    }
    #economics input[type='range']:focus-visible::-moz-range-thumb {
      outline: 2px solid var(--signal-local);
      outline-offset: 3px;
    }
    @media (prefers-reduced-motion: reduce) {
      #economics [data-bar],
      #economics input[type='range']::-webkit-slider-thumb {
        transition: none;
      }
    }
  </style>
</section>

<script>
  import { CLOUD_MODELS } from '../data/telemetry';
  import {
    computeEconomics,
    fmtUsd,
    fmtUsdCompact,
    fmtKwh,
    fmtPayback,
    fmtTokensM,
    dispatchEconomicsUpdate,
  } from '../scripts/economics-calc';

  const sectionEl = document.getElementById('economics');
  if (!sectionEl) throw new Error('economics-calc: section not found');
  const section = sectionEl;

  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)');

  const sliders = Array.from(
    section.querySelectorAll<HTMLInputElement>(
      "input[type='range'][data-param]",
    ),
  );
  const modelButtons = Array.from(
    section.querySelectorAll<HTMLButtonElement>('[data-model-index]'),
  );
  const cacheButtons = Array.from(
    section.querySelectorAll<HTMLButtonElement>('[data-cache]'),
  );
  const presetButtons = Array.from(
    section.querySelectorAll<HTMLButtonElement>('[data-preset-key]'),
  );

  const PRESETS: Array<{
    key: string;
    team: number;
    volume: number;
    offload: number;
    rate: number;
  }> = [
    { key: 'solo', team: 1, volume: 200, offload: 90, rate: 0.18 },
    { key: 'startup', team: 5, volume: 150, offload: 85, rate: 0.18 },
    { key: 'enclave', team: 25, volume: 180, offload: 90, rate: 0.14 },
  ];

  const state = {
    modelIndex: 4, // Claude Sonnet 5.5 (matches SSR preset default)
    teamSize: 5,
    tokensPerEngineerM: 150,
    localOffloadPct: 85,
    electricityRate: 0.18,
    useRealAgenticCache: true,
  };

  function inputs(): Parameters<typeof computeEconomics>[0] {
    return {
      model: CLOUD_MODELS[state.modelIndex],
      teamSize: state.teamSize,
      tokensPerEngineerM: state.tokensPerEngineerM,
      localOffloadPct: state.localOffloadPct,
      electricityRate: state.electricityRate,
      useRealAgenticCache: state.useRealAgenticCache,
    };
  }

  function readouts(): void {
    const team = section.querySelector<HTMLElement>('#ec-team-readout');
    const volume = section.querySelector<HTMLElement>('#ec-volume-readout');
    const offload = section.querySelector<HTMLElement>('#ec-offload-readout');
    const rate = section.querySelector<HTMLElement>('#ec-rate-readout');
    if (team) {
      team.textContent =
        state.teamSize === 1 ? '1 engineer' : `${state.teamSize} engineers`;
    }
    if (volume) {
      volume.textContent = `${Math.round(state.tokensPerEngineerM)}M tokens / mo`;
    }
    if (offload) {
      offload.textContent = `${Math.round(state.localOffloadPct)}% on local silicon`;
    }
    if (rate) {
      rate.textContent = `$${state.electricityRate.toFixed(2)}/kWh`;
    }
  }

  /**
   * Renders every readout from `state`. `easing` is the current value of an
   * rAF easing factor (0..1) used only by preset transitions: the numeric
   * dollar/percentage cells are interpolated between their last rendered
   * values and the new computed ones, so preset clicks count smoothly.
   * Pass undefined (or run under reduced motion) for an instant snap.
   */
  let prev: Record<string, number> | null = null;

  function render(easing?: number): void {
    const m = CLOUD_MODELS[state.modelIndex];
    const o = computeEconomics(inputs());

    const set = (sel: string, v: string) => {
      const el = section.querySelector<HTMLElement>(sel);
      if (el) el.textContent = v;
    };

    const setNum = (sel: string, value: number) => {
      const el = section.querySelector<HTMLElement>(sel);
      if (!el) return;
      const key = sel.replace(/[\[\]="]/g, '');
      if (easing !== undefined && !REDUCED.matches && prev && key in prev) {
        const from = prev[key];
        el.textContent = fmtUsdCompact(from + (value - from) * easing);
      } else {
        el.textContent = fmtUsdCompact(value);
      }
      if (prev) prev[key] = value;
    };
    prev = prev ?? {};

    const cloudPct = (o.hybridCloudUsd / o.cloudOnlyUsd) * 100;
    const localPct = (o.hybridLocalUsd / o.cloudOnlyUsd) * 100;

    set(
      '[data-assumptions]',
      `${Math.round(state.teamSize)} engineer${
        Math.round(state.teamSize) === 1 ? '' : 's'
      } × ${Math.round(state.tokensPerEngineerM)}M = ${fmtTokensM(
        o.totalTokensM,
      )} tokens/mo · 97.7% prompt / 2.3% output · effective ${fmtUsd(
        o.costPerM,
        2,
      )}/1M${state.useRealAgenticCache ? ' (70% cached)' : ' (uncached)'}`,
    );
    setNum('[data-cell="cloudOnly"]', o.cloudOnlyUsd);
    set(
      '[data-cellSub="cloudOnly"]',
      `${fmtUsd(o.cloudOnlyUsd)} all-cloud at ${m.name}`,
    );
    setNum('[data-cell="hybrid"]', o.hybridTotalUsd);
    set(
      '[data-cellSub="hybrid"]',
      `${fmtUsd(o.hybridCloudUsd)} cloud + ${fmtKwh(o.hybridLocalKwh)} local`,
    );
    setNum('[data-cell="annual"]', o.annualSavingsUsd);
    set('[data-cellSub="annual"]', `${fmtUsd(o.monthlySavingsUsd)}/mo × 12`);
    set('[data-cell="payback"]', fmtPayback(o.paybackMonths));
    set(
      '[data-cellSub="payback"]',
      `${o.nodes} node${o.nodes === 1 ? '' : 's'} · ${fmtUsd(
        o.hardwareCostUsd,
      )} hardware`,
    );
    setNum('[data-barLabel="cloudOnly"]', o.cloudOnlyUsd);
    setNum('[data-barLabel="hybrid"]', o.hybridTotalUsd);

    const barCloud = section.querySelector<HTMLElement>('[data-bar="cloudOnly"]');
    const barHC = section.querySelector<HTMLElement>('[data-bar="hybridCloud"]');
    const barHL = section.querySelector<HTMLElement>('[data-bar="hybridLocal"]');
    if (barCloud) barCloud.style.width = '100%';
    if (barHC) barHC.style.width = `${cloudPct.toFixed(2)}%`;
    if (barHL) barHL.style.width = `${localPct.toFixed(2)}%`;

    const note = section.querySelector<HTMLElement>('#ec-haiku-note');
    if (note) {
      note.classList.toggle('hidden', m.name !== 'Claude Haiku 5.5');
    }

    readouts();

    // Conversion hook: publish the live state so DeploymentTiers can
    // personalize its mailto Sprint / Enterprise Pilot bodies.
    dispatchEconomicsUpdate({
      modelName: m.name,
      teamSize: state.teamSize,
      monthlyTokensM: o.totalTokensM,
      annualSavingsFmt: fmtUsdCompact(o.annualSavingsUsd),
      hybridMonthlyFmt: fmtUsd(o.hybridTotalUsd),
    });
  }

  /* ── Preset transitions: rAF-eased slider + numeric animation ────── */

  const easeOutCubic = (t: number): number => 1 - Math.pow(1 - t, 3);

  let tweenRaf = 0;

  function runPresetTween(targets: {
    teamSize: number;
    tokensPerEngineerM: number;
    localOffloadPct: number;
    electricityRate: number;
  }): void {
    window.cancelAnimationFrame(tweenRaf);
    const from = {
      teamSize: state.teamSize,
      tokensPerEngineerM: state.tokensPerEngineerM,
      localOffloadPct: state.localOffloadPct,
      electricityRate: state.electricityRate,
    };

    if (REDUCED.matches) {
      state.teamSize = targets.teamSize;
      state.tokensPerEngineerM = targets.tokensPerEngineerM;
      state.localOffloadPct = targets.localOffloadPct;
      state.electricityRate = targets.electricityRate;
      sliders.forEach((sl) => {
        sl.value = String(targets[sl.dataset.param as keyof typeof targets]);
      });
      syncPresetChips();
      render();
      return;
    }

    const start = performance.now();
    const DUR = 450;
    const frame = (now: number) => {
      const p = Math.min(1, (now - start) / DUR);
      const e = easeOutCubic(p);
      for (const sl of sliders) {
        const k = sl.dataset.param as
          | 'teamSize'
          | 'tokensPerEngineerM'
          | 'localOffloadPct'
          | 'electricityRate';
        const v = from[k] + (targets[k] - from[k]) * e;
        state[k] = v;
        sl.value = String(v);
      }
      render(e);
      if (p < 1) {
        tweenRaf = requestAnimationFrame(frame);
      } else {
        state.teamSize = targets.teamSize;
        state.tokensPerEngineerM = targets.tokensPerEngineerM;
        state.localOffloadPct = targets.localOffloadPct;
        state.electricityRate = targets.electricityRate;
        sliders.forEach((sl) => {
          const k = sl.dataset.param as
            | 'teamSize'
            | 'tokensPerEngineerM'
            | 'localOffloadPct'
            | 'electricityRate';
          sl.value = String(targets[k]);
          state[k] = targets[k];
        });
        syncPresetChips();
        render();
      }
    };
    tweenRaf = requestAnimationFrame(frame);
  }

  const TOL = 0.001; // numeric tolerance for preset matching

  function presetMatches(
    p: (typeof PRESETS)[number],
  ): boolean {
    return (
      Math.abs(state.teamSize - p.team) <= TOL &&
      Math.abs(state.tokensPerEngineerM - p.volume) <= TOL &&
      Math.abs(state.localOffloadPct - p.offload) <= TOL &&
      Math.abs(state.electricityRate - p.rate) <= TOL
    );
  }

  /**
   * Highlights the preset chip whose { team, volume, offload, elec } quadruple
   * matches the live state (numeric tolerance 0.001) — no model index
   * involvement, so a click on ANY chip immediately puts `aria-pressed="true"`
   * + the active `tactile-key--local is-pressed` styling on that chip and
   * clears it on the others.
   */
  function syncPresetChips(): void {
    presetButtons.forEach((btn) => {
      const p = PRESETS.find((x) => x.key === btn.dataset.presetKey);
      const active = !!p && presetMatches(p);
      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      btn.classList.toggle('is-pressed', active);
      btn.classList.toggle('tactile-key--local', active);
      btn.classList.toggle('text-ink', active);
      btn.classList.toggle('text-ink-secondary', !active);
    });
  }

  /* ── Interactions ─────────────────────────────────────────────────── */

  sliders.forEach((sl) => {
    sl.addEventListener('input', () => {
      window.cancelAnimationFrame(tweenRaf);
      const v = Number(sl.value);
      switch (sl.dataset.param) {
        case 'teamSize':
          state.teamSize = v;
          break;
        case 'tokensPerEngineerM':
          state.tokensPerEngineerM = v;
          break;
        case 'localOffloadPct':
          state.localOffloadPct = v;
          break;
        case 'electricityRate':
          state.electricityRate = v;
          break;
      }
      syncPresetChips();
      render();
    });
  });

  presetButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const p = PRESETS.find((x) => x.key === btn.dataset.presetKey);
      if (!p) return;
      // Immediate visual commitment to the clicked chip — the rAF tween then
      // eases the sliders into the preset quadruple; on completion (or
      // under reduced motion, instantly) syncPresetChips() confirms it.
      presetButtons.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-pressed', active ? 'true' : 'false');
        b.classList.toggle('is-pressed', active);
        b.classList.toggle('tactile-key--local', active);
        b.classList.toggle('text-ink', active);
        b.classList.toggle('text-ink-secondary', !active);
      });
      runPresetTween({
        teamSize: p.team,
        tokensPerEngineerM: p.volume,
        localOffloadPct: p.offload,
        electricityRate: p.rate,
      });
    });
  });

  modelButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      state.modelIndex = Number(btn.dataset.modelIndex);
      modelButtons.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-checked', active ? 'true' : 'false');
        b.classList.toggle('is-pressed', active);
      });
      render();
    });
  });

  cacheButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      state.useRealAgenticCache = btn.dataset.cache === 'real';
      cacheButtons.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-checked', active ? 'true' : 'false');
        b.classList.toggle('is-pressed', active);
        b.classList.toggle('tactile-key--cloud', active);
        b.classList.toggle('text-ink', active);
        b.classList.toggle('text-ink-secondary', !active);
      });
      render();
    });
  });

  // Hydration: sync the SSR default and publish the initial conversion state.
  syncPresetChips();
  render();
</script>
