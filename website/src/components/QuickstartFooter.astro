---
/**
 * Castor — 60-Second CLI Quickstart (embedded OLED instrument) + Industrial
 * Footer. The terminal sits starkly on the warm paper ground as a machined
 * dark chassis; the footer is pure Swiss Industrial Paper on --bg-ground
 * with a 1px top hairline. Copy buttons are real clipboard writes with
 * visible inline feedback — zero deprecated execCommand, zero CS4012 labels.
 */
import { ARCHITECTURE } from '../data/telemetry';

const GITHUB = ARCHITECTURE.links.github;
const NPM = ARCHITECTURE.links.npm;
const EMAIL = 'ApatheticMioz@gmail.com';
// Deployment base path: '/' on Vercel, '/Castor' on GitHub Pages.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const commands: Array<{ comment: string; cmd: string }> = [
  {
    comment: '# 1. Install & register MCP tools with Claude Code / Antigravity',
    cmd: 'npx -y mcp-castor install --client all',
  },
  {
    comment: '# 2. Verify your local serving engine (vLLM / llama.cpp / Ollama)',
    cmd: 'castor server status',
  },
  {
    comment: '# 3. Inspect live token throughput, KV cache hit rate, and savings',
    cmd: 'castor stats',
  },
];

const midLinks = [
  { label: 'GitHub', href: GITHUB },
  { label: 'npm (mcp-castor)', href: NPM },
  { label: 'Architecture Docs', href: `${GITHUB}/tree/main/docs` },
  { label: 'Engine Profiles', href: `${GITHUB}/blob/main/docs/engine-profiles.md` },
  { label: 'Commercial Deployments', href: `${GITHUB}/blob/main/docs/commercial-deployments.md` },
  { label: EMAIL, href: `mailto:${EMAIL}` },
];
---

<section
  id="quickstart"
  data-reveal
  class="scroll-mt-16 mx-auto max-w-6xl px-6 py-16"
>
  <header class="mb-8">
    <p class="font-mono text-[11px] uppercase tracking-widest text-ink-muted">
      {`// quickstart`} · sixty seconds from zero to telemetry
    </p>
    <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink md:text-4xl">
      Run it. Watch it. Verify it.
    </h2>
  </header>

  <!-- Embedded dark OLED instrument chassis on the paper ground. -->
  <div class="instrument-chassis">
    <div
      class="flex items-center justify-between border-b border-[var(--bg-instrument-border)] bg-[var(--bg-instrument-raised)] px-4 py-2"
    >
      <span class="font-mono text-[11px] uppercase tracking-widest text-ink-instrument-muted">
        bash · castor-cli
      </span>
      <button
        type="button"
        class="border border-white/15 bg-[#151A24] px-3 py-1 font-mono text-[10px] uppercase tracking-widest text-[#F3F5F8] transition-colors hover:border-[#F97316] hover:text-[#F97316]"
        data-copy-all
      >
        copy all
      </button>
    </div>

    <div class="p-4 md:p-6">
      <ol class="space-y-4">
        {commands.map((c) => (
          <li>
            <p class="font-mono text-xs text-ink-instrument-muted md:text-sm">
              {c.comment}
            </p>
            <div class="mt-1 flex items-center gap-3">
              <code class="flex-1 overflow-x-auto whitespace-nowrap font-mono text-xs md:text-sm">
                <span class="text-local-oled">$</span>
                <span class="text-ink-instrument">{c.cmd}</span>
              </code>
              <button
                type="button"
                class="shrink-0 border border-white/15 bg-[#151A24] px-2.5 py-1 font-mono text-[10px] uppercase tracking-widest text-[#F3F5F8] transition-colors hover:border-[#F97316] hover:text-[#F97316]"
                data-copy={c.cmd}
                aria-label={`Copy command: ${c.cmd}`}
              >
                copy
              </button>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <p class="mt-4 overflow-x-auto whitespace-nowrap font-mono text-[11px] tracking-wider text-ink-muted">
    CLAUDE CODE · ANTIGRAVITY · CURSOR · ANY MCP HOST
    <span class="mx-3 text-hairline">|</span>
    vLLM · llama.cpp · SGLANG · OLLAMA · LM STUDIO
  </p>
</section>

<footer class="border-t border-hairline bg-ground">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-10 lg:flex-row lg:items-center lg:justify-between"
  >
    <div class="flex items-center gap-3">
      <img
        src={`${base}/assets/logo.svg`}
        alt="Castor"
        width="24"
        height="24"
        class="h-6 w-6"
        loading="lazy"
        decoding="async"
      />
      <div>
        <p class="font-display text-sm font-bold tracking-tight text-ink">
          CASTOR · Rust Agent Microkernel · v1.5.0 · GNU AGPL-3.0
        </p>
      </div>
    </div>

    <nav aria-label="Footer" class="flex flex-wrap gap-x-5 gap-y-2">
      {midLinks.map((l) => (
        <a
          href={l.href}
          class="font-mono text-[11px] text-ink-secondary underline decoration-hairline underline-offset-4 hover:text-ink"
        >
          {l.label}
        </a>
      ))}
    </nav>

    <p class="font-mono text-[11px] text-ink-muted lg:text-right">
      TELEMETRY SNAPSHOT: 2026-11-19 · ZERO TRACKERS · ZERO COOKIES
    </p>
  </div>
</footer>

<script>
  // Real clipboard writes, real inline feedback. No modals, no fake success,
  // and no deprecated clipboard path: on non-secure contexts the button
  // reports the manual-copy fallback instead.
  function writeClipboard(text: string): Promise<boolean> {
    if (navigator.clipboard?.writeText) {
      return navigator.clipboard.writeText(text).then(() => true, () => false);
    }
    return Promise.resolve(false);
  }

  function flash(btn: HTMLButtonElement, label: string, ok: boolean) {
    const original = ok ? label : 'select & copy manually';
    btn.textContent = original;
    btn.classList.toggle('text-white', ok);
    window.setTimeout(() => {
      btn.textContent = label;
      btn.classList.remove('text-white');
    }, 2000);
  }

  for (const btn of Array.from(
    document.querySelectorAll<HTMLButtonElement>('#quickstart [data-copy]'),
  )) {
    btn.addEventListener('click', () => {
      const cmd = btn.dataset.copy ?? '';
      writeClipboard(cmd).then((ok) => flash(btn, 'copy', ok));
    });
  }

  const allBtn = document.querySelector<HTMLButtonElement>('#quickstart [data-copy-all]');
  if (allBtn) {
    allBtn.addEventListener('click', () => {
      // Copy all three commands with their comments for full context.
      const full = Array.from(
        document.querySelectorAll<HTMLButtonElement>('#quickstart [data-copy]'),
      )
        .map((b) => {
          const comment = b.closest('li')?.querySelector('p')?.textContent?.trim();
          const cmd = b.dataset.copy ?? '';
          return comment ? `${comment}\n${cmd}` : cmd;
        })
        .filter(Boolean)
        .join('\n');
      writeClipboard(full).then((ok) => flash(allBtn, 'copy all', ok));
    });
  }
</script>
