---
import { LEDGER_76DAY } from '../data/telemetry';

const L = LEDGER_76DAY; // 76-day ledger: 2.56B prompt, 2.39B cached (93.7%)
---

<section id="speed-race" data-reveal class="scroll-mt-16 border-y border-hairline bg-recessed/40">
  <!-- ── Section header ─────────────────────────────────────────── -->
  <div class="border-b border-hairline">
    <div class="mx-auto max-w-6xl px-4 py-5 sm:px-6">
      <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        Where Your Frontier API Budget Actually Goes.
      </h2>
      <p class="mt-1 font-mono text-xs text-ink-muted">
        76-day ledger · <span class="tabular text-ink-secondary">{L.promptTokensDisplay} prompt tokens</span>
        · measured on 1× RTX 3090, <span class="tabular">{L.windowStart} – {L.windowEnd}</span>
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
    <!-- ── Part A · Scroll-triggered animated split bar ─────────── -->
    <div class="ts-barwrap" id="ts-split-bar">
      <!-- Top legend row: full labels live here so the bar segments only
           need to carry the bare percentages (zero truncation at 390px). -->
      <div class="mb-1.5 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.06em] text-local">
          93.7% LOCAL SILICON
        </p>
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.06em] text-cloud">
          6.3% CLOUD LEAD
        </p>
      </div>
      <div class="ts-track">
        <div class="ts-fill">
          <span class="ts-stripe" aria-hidden="true"></span>
          <span class="ts-fill-label">
            <b class="ts-big">93.7%</b>
          </span>
        </div>
        <div class="ts-cloud">
          <span class="ts-fill-label ts-cloud-label">6.3%</span>
        </div>
      </div>
      <p class="mt-2 text-right font-mono text-[11px] text-ink-muted">
        2.39B of 2.56B prompt tokens (93.7%) — repetitive repo context, file reads, grep results, and tool outputs · $9.38 total power cost / 76D
      </p>
    </div>

    <!-- 2-column architectural split caption -->
    <div class="mt-6 grid grid-cols-1 gap-px border border-hairline bg-hairline sm:grid-cols-2">
      <div class="bg-surface p-4">
        <p class="font-mono text-[11px] uppercase tracking-widest text-cloud">
          Cloud Lead · 6.3% — architecture tier
        </p>
        <p class="mt-2 font-mono text-[11px] leading-relaxed text-ink-secondary">
          Owns <span class="text-ink">architecture decisions, diff authorship, and synthesis</span> — the
          irreducible reasoning core. Sent as short, stateless dispatches; never re-reading the repository.
        </p>
      </div>
      <div class="border-l-0 border-t-2 border-l-2 border-t-[var(--signal-local)] bg-surface p-4 sm:border-l sm:border-t-0 sm:border-l-[var(--signal-local)]">
        <p class="font-mono text-[11px] uppercase tracking-widest text-local">
          Local Peer · 93.7% — execution tier
        </p>
        <p class="mt-2 font-mono text-[11px] leading-relaxed text-ink-secondary">
          <span class="text-ink">Qwen3.8-27B on 1× RTX 3090</span> owns
          <span class="text-ink"> file reads, AST surgery, and test loops</span> — 2.39B cached prompt tokens
          served from the warm KV pool at <span class="tabular">$9.38 total power cost</span> over 76 days.
        </p>
      </div>
    </div>

    <!-- ── Part B · Side-by-side speed race (embedded dark OLED bench) ── -->
    <div class="instrument-chassis mt-8 p-4 sm:p-5">
      <!-- Chassis header -->
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <span class="ts-led" aria-hidden="true"></span>
          <p class="font-mono text-xs font-semibold uppercase tracking-widest text-ink-instrument">
            120K-Context Multi-File Refactor Race · 12 Agent Turns · Identical Task
          </p>
        </div>
        <button
          type="button"
          id="ts-race-btn"
          class="tactile-btn tactile-btn--primary text-[11px] tracking-widest"
          aria-label="Run the 120K-context speed race"
        >
          RUN RACE ▶
        </button>
      </div>

      <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
        <!-- ── Lane 1 · Local silicon ─────────────────────────────── -->
        <div class="border border-[rgba(249,115,22,0.35)] bg-[var(--bg-instrument-raised)] p-4">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <p class="font-mono text-[11px] uppercase tracking-widest text-local-oled">
              Lane 1 · Castor + Qwen3.8-27B · 1× RTX 3090
            </p>
            <p class="font-mono text-[10px] uppercase tracking-wider text-ink-instrument-muted">
              warm KV + MTP speculative decode
            </p>
          </div>
          <div class="ts-phase mt-3" id="ts-phase-local">
            <span class="ts-phase-led" aria-hidden="true"></span>
            <span class="ts-phase-text">ARMED · 93.7% KV prefix hot in VRAM</span>
          </div>
          <div class="ts-rail mt-3">
            <div class="ts-rail-fill ts-rail-fill--local" id="ts-rail-local"></div>
          </div>
          <div class="mt-3 flex flex-wrap items-baseline justify-between gap-2">
            <p class="tabular font-mono text-lg font-semibold text-ink-instrument">
              <span id="ts-local-cost">$0.000</span><span class="ml-1 text-[11px] font-normal text-ink-instrument-muted">API</span>
            </p>
            <p class="tabular font-mono text-[11px] text-ink-instrument-muted">
              <span id="ts-local-tel">0.0 tok/s</span> · ~0.002 kWh local
            </p>
            <p class="font-mono text-[11px] font-semibold text-ink-instrument-muted" id="ts-local-done" aria-live="polite">
              —
            </p>
          </div>
        </div>

        <!-- ── Lane 2 · Cloud-only ─────────────────────────────────── -->
        <div class="border border-[rgba(59,130,246,0.4)] bg-[var(--bg-instrument-raised)] p-4">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <p class="font-mono text-[11px] uppercase tracking-widest text-cloud-oled">
              Lane 2 · Cloud-Only Frontier Loop
            </p>
            <p class="font-mono text-[10px] uppercase tracking-wider text-ink-instrument-muted">
              Claude Opus 5.5 · $4 / $20 per 1M
            </p>
          </div>
          <div class="ts-phase mt-3" id="ts-phase-cloud">
            <span class="ts-phase-led" aria-hidden="true"></span>
            <span class="ts-phase-text">ARMED · context resends every turn — no shared KV</span>
          </div>
          <div class="ts-rail mt-3">
            <div class="ts-rail-fill ts-rail-fill--cloud" id="ts-rail-cloud"></div>
          </div>
          <div class="mt-3 flex flex-wrap items-baseline justify-between gap-2">
            <p class="tabular font-mono text-lg font-semibold text-cloud-oled" id="ts-cloud-cost">
              $0.00
            </p>
            <p class="tabular font-mono text-[11px] text-ink-instrument-muted">
              <span id="ts-cloud-tel">T0 / 12</span> · 3.22 s avg TTFT
            </p>
            <p class="font-mono text-[11px] font-semibold text-ink-instrument-muted" id="ts-cloud-done" aria-live="polite">
              —
            </p>
          </div>
        </div>
      </div>

      <!-- Verdict strip -->
      <div class="ts-verdict mt-4">
        <p class="font-mono text-[11px] uppercase tracking-widest text-ink-instrument-muted">Verdict · same task</p>
        <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-3">
          <p class="border-l-2 border-l-[var(--signal-ok-oled)] pl-3 font-mono text-[11px] leading-relaxed text-ink-instrument">
            <b class="text-ok-oled">$0.000 API cost</b> — local lane completes for ~0.002 kWh of house power
          </p>
          <p class="border-l-2 border-l-[var(--signal-cloud-oled)] pl-3 font-mono text-[11px] leading-relaxed text-ink-instrument">
            <b class="text-cloud-oled">93.7% prefix reused</b> — warm KV pool serves the repeated context, no re-egress
          </p>
          <p class="border-l-2 border-l-[var(--signal-local-oled)] pl-3 font-mono text-[11px] leading-relaxed text-ink-instrument">
            <b class="text-local-oled">100% local workspace</b> — cloud lane bills $1.84 re-sending uncached reads across 12 turns
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Part A · 48px split bar on a pure-white surface, 1px ink frame ── */
  .ts-track {
    position: relative;
    display: flex;
    height: 48px;
    background: var(--bg-surface);
    border: 1px solid var(--border-ink);
    overflow: hidden;
  }
  .ts-fill {
    position: relative;
    width: 0%;
    background: var(--signal-local);
    overflow: hidden;
    will-change: width;
    transition: width 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ts-barwrap.is-in-view .ts-fill {
    width: 93.7%;
  }
  .ts-stripe {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      -45deg,
      rgba(255, 255, 255, 0.18) 0,
      rgba(255, 255, 255, 0.18) 7px,
      transparent 7px,
      transparent 14px
    );
  }
  .ts-cloud {
    position: relative;
    flex: 1 0 0%;
    min-width: 0;
    background: var(--signal-cloud);
    display: flex;
    align-items: center;
  }
  .ts-fill-label {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: calc(100% - 1.5rem);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #ffffff;
    opacity: 0;
    transition: opacity 0.35s ease 0.35s;
  }
  .ts-barwrap.is-in-view .ts-fill-label {
    opacity: 1;
  }
  /* Cloud segment: the bare 6.3% is dead-center in the segment and never
     runs into a text-overflow ellipsis in the narrow cobalt band. */
  .ts-cloud .ts-cloud-label {
    left: 0;
    right: 0;
    max-width: none;
    overflow: visible;
    text-align: center;
  }
  .ts-big {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .ts-dim {
    color: rgba(255, 255, 255, 0.85);
    font-weight: 400;
  }
  @media (prefers-reduced-motion: reduce) {
    .ts-fill,
    .ts-fill-label {
      transition: none;
    }
  }

  /* ── Part B · race chassis internals (always dark OLED hardware) ── */
  .ts-led {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal-ok-oled);
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.12);
  }
  .ts-rail {
    height: 8px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
  }
  .ts-rail-fill {
    height: 100%;
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }
  .ts-rail-fill--local {
    background: var(--signal-local-oled);
  }
  .ts-rail-fill--cloud {
    background: var(--signal-cloud-oled);
  }
  .ts-phase {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 22px;
  }
  .ts-phase-led {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--ink-instrument-muted);
  }
  .ts-phase[data-state='prefill'] .ts-phase-led {
    background: var(--signal-ok-oled);
    animation: ts-blink 0.5s steps(2, start) infinite;
  }
  .ts-phase[data-state='decode'] .ts-phase-led {
    background: var(--signal-local-oled);
  }
  .ts-phase[data-state='done'] .ts-phase-led {
    background: var(--signal-ok-oled);
  }
  .ts-phase[data-state='cloudrun'] .ts-phase-led {
    background: var(--signal-cloud-oled);
  }
  .ts-phase-text {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--ink-instrument-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @keyframes ts-blink {
    50% {
      opacity: 0.2;
    }
  }
  .ts-verdict {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.45s ease, transform 0.45s ease;
    border: 1px solid var(--bg-instrument-border);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.75rem 1rem;
  }
  .ts-verdict.is-on {
    opacity: 1;
    transform: none;
  }
  .instrument-chassis .tactile-btn--primary {
    background: #e04f00;
    border-color: #e04f00;
    color: #ffffff;
  }
  .instrument-chassis .tactile-btn--primary:hover {
    background: #f97316;
    border-color: #f97316;
  }
  .instrument-chassis .tactile-btn--primary.is-disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  @media (prefers-reduced-motion: reduce) {
    .ts-verdict,
    .ts-phase-led {
      transition: none;
      animation: none;
    }
  }
</style>

<script src="../scripts/token-split.ts"></script>
