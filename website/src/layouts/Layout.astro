---
// Fontsource — latin subsets only. The full per-weight bundles (400.css …
// 700.css) ship Cyrillic / Cyrillic-ext / Greek / Vietnamese woff2 files
// (≈4.3 MB across IBM Plex Sans + Mono) that a Latin-only English site never
// renders. Importing the `<subset>-<weight>.css` files keeps dist/ to the
// handful of woff2 files the browser can actually match. Archivo is a
// variable font: `wght.css` carries its vietnamese / latin-ext / latin
// @font-face blocks, of which only `latin` is downloadable on this page.
import '@fontsource-variable/archivo/wght.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-sans/latin-700.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Canonical path on the deployment root, e.g. '/' or '/deploy/air-gapped/'. */
  canonicalPath?: string;
  /** Optional page-specific schema.org object (or array) emitted alongside the
      base SoftwareApplication node (e.g. FAQPage, TechArticle, BreadcrumbList). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, canonicalPath = '/', jsonLd } = Astro.props;
// Deployment base path: '/' on Vercel, '/Castor' on GitHub Pages.
// BASE_URL is injected by Astro from `base` in astro.config.mjs; stripping the
// trailing slash keeps `${base}/assets/...` free of double slashes at both
// targets.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Site origin (no trailing slash) + base => absolute canonical + OG URLs.
const siteUrl = (Astro.site ? new URL(Astro.site) : new URL('http://localhost'))
  .href.replace(/\/$/, '');
// Clean per-page canonical: site + base + path (default '/' => deployment root).
const canonical = `${siteUrl}${base}${canonicalPath}`;
// Shared OG / Twitter card: the 1200×630 Swiss-paper + OLED social card.
const ogImage = `${siteUrl}${base}/assets/og-card.png`;

const meta: Array<Record<string, string>> = [
  { name: 'description', content: description },
  // Default first paint is the Swiss paper ground; the pre-paint script below
  // re-points this meta at the obsidian ground only when the user opted in.
  { name: 'theme-color', content: '#F5F4F0' },
  { property: 'og:type', content: 'website' },
  { property: 'og:site_name', content: 'Castor Technologies' },
  { property: 'og:title', content: title },
  { property: 'og:description', content: description },
  { property: 'og:url', content: canonical },
  { property: 'og:image', content: ogImage },
  { property: 'og:image:width', content: '1200' },
  { property: 'og:image:height', content: '630' },
  { property: 'og:image:alt', content: title },
  { name: 'twitter:card', content: 'summary_large_image' },
  { name: 'twitter:title', content: title },
  { name: 'twitter:description', content: description },
  { name: 'twitter:image', content: ogImage },
];

const links: Array<Record<string, string>> = [
  { rel: 'icon', type: 'image/svg+xml', href: `${base}/assets/favicon.svg` },
];

// ── Structured data (GEO / AI search) ───────────────────────────────
// A single JSON-LD block: the fixed SoftwareApplication node plus any
// page-specific node(s) (FAQPage / TechArticle / BreadcrumbList) passed in.
// `@context` is set once so child nodes inherit it.
const softwareApplication: Record<string, unknown> = {
  '@type': 'SoftwareApplication',
  name: 'Castor',
  alternateName: 'mcp-castor',
  softwareVersion: '1.5.0',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Windows, Linux, macOS',
  license: 'https://www.gnu.org/licenses/agpl-3.0.en.html',
  url: canonical,
  description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  codeRepository: 'https://github.com/ApatheticMioz/Castor',
  sameAs: [
    'https://github.com/ApatheticMioz/Castor',
    'https://www.npmjs.com/package/mcp-castor',
  ],
};
// A JSON-LD graph: `@context` plus an `@graph` array containing the
// SoftwareApplication node and any page-specific node(s). Always emitted
// (the index page carries SoftwareApplication alone; subpages add FAQPage /
// TechArticle / BreadcrumbList, etc.).
const graph: Record<string, unknown>[] = [softwareApplication];
if (jsonLd) graph.push(...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]));
const jsonLdGraph: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta name="generator" content={Astro.generator} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {meta.map((m) => <meta {...m} />)}
    {links.map((l) => <link {...l} />)}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />
    <script is:inline>
      // Pre-paint theme restore. Runs inline in <head>, before first paint, so
      // there is zero flash of the wrong theme:
      //   · Default is ALWAYS light 'paper' (no attribute) — the signature
      //     Swiss Industrial Paper aesthetic every first-time visitor sees.
      //   · data-theme='dark' is applied ONLY when the user explicitly
      //     saved 'dark' to localStorage via the tactile Light/Dark switch.
      // Kept is:inline (no bundling) so it executes before the stylesheets
      // are even parsed; all access is guarded so it can never throw.
      try {
        var t = localStorage.getItem('castor-theme');
        if (t === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
          var tm = document.querySelector('meta[name="theme-color"]');
          if (tm) tm.setAttribute('content', '#07090D');
        }
      } catch (e) {
        /* storage unavailable — fall through to the light default */
      }
    </script>
  </head>
  <body>
    <!-- Keyboard-accessible skip link (WCAG 2.4.1): hidden until it receives
         keyboard focus, then it jumps past the sticky header to main content. -->
    <a
      href="#main-content"
      class="skip-link sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60]"
    >
      Skip to content
    </a>
    <slot />
    <script>
      // ── Castor motion bootstrap ───────────────────────────────────────
      // Lenis smooth scroll + GSAP ScrollTrigger, bundled by Vite
      // (content-hashed) and executed after DOM parse.
      //
      // Modules:
      //   1. Scroll progress   — 2px International Orange bar, GPU-only
      //                          (scaleX 0→1, origin left center).
      //   2. Hero line reveal  — [data-hero-reveal] masked lines, 0.6 s
      //                          power3.out stagger, on load.
      //   3. Section reveal    — [data-reveal] single elements and
      //                          [data-stagger-group] children, power3.out,
      //                          clearProps on completion, 2.5 s safety
      //                          fallback so nothing can ever stay hidden.
      //   4. Odometer counters — [data-count-to] integers/decimals/currency,
      //                          triggered once on viewport entry.
      //   5. Theme hook        — 'castor:theme-change' CustomEvent for
      //                          Canvas components re-reading CSS variables.
      //
      // Hard safety nets:
      //   · prefers-reduced-motion: reduce → no Lenis, no tweens; every
      //     element stays at opacity 1 and counters jump to final value.
      //   · Above-the-fold LCP paint is never delayed by reveal setup.
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);

      // All browser work is wrapped in an SSR guard so the module is safe to
      // evaluate during Astro's static build (no `window` / `matchMedia` on
      // the server); the wiring below runs on the client after DOM parse.
      if (typeof window !== 'undefined') {
        const REDUCED = matchMedia('(prefers-reduced-motion: reduce)');
        let lenis: Lenis | null = null;
        let motionKilled = false;

        /* 1 ── Scroll progress bar (GPU-only transform) ──────────────── */
        function initProgress(): void {
          const bar = document.querySelector<HTMLElement>('.scroll-progress');
          if (!bar) return;
          gsap.set(bar, { transformOrigin: 'left center', scaleX: 0 });
          gsap.to(bar, {
            scaleX: 1,
            ease: 'none',
            scrollTrigger: {
              start: 0,
              end: () => ScrollTrigger.maxScroll(window),
              scrub: 0.3,
            },
          });
        }

        /* 2 ── Hero masked line reveals, on load ─────────────────────── */
        function initHeroReveal(): void {
          const lines = Array.from(document.querySelectorAll<HTMLElement>('[data-hero-reveal]'));
          if (lines.length === 0) return;

          if (REDUCED.matches) {
            // Never leave a hero line hidden under reduced motion.
            lines.forEach((el) => gsap.set(el, { clearProps: 'transform,opacity' }));
            return;
          }

          gsap.set(lines, { autoAlpha: 0, yPercent: 110 });
          const tl = gsap.timeline({ delay: 0.05 });
          lines.forEach((el, i) => {
            tl.to(el, { autoAlpha: 1, yPercent: 0, duration: 0.6, ease: 'power3.out', clearProps: 'transform,opacity', onStart: () => gsap.set(el, { transformOrigin: 'left' }) }, i * 0.08);
          });
          // Failsafe: if a flaky timeline never completes, force the lines
          // visible. Clearing finished props is a harmless no-op.
          window.setTimeout(() => {
            lines.forEach((el) => gsap.set(el, { autoAlpha: 1, clearProps: 'transform,opacity' }));
          }, 2500);
        }

        /* 3 ── Below-the-fold reveals: single + stagger groups ───────── */
        function initReveal(): void {
          if (motionKilled) return;
          const singles = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
          const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-stagger-group]'));
          if (singles.length === 0 && groups.length === 0) return;

          for (const el of singles) {
            // Sections already on screen at first paint animate in
            // immediately; below-the-fold ones wait for the 88% trigger.
            const aboveFold = el.getBoundingClientRect().top < window.innerHeight;
            gsap.fromTo(
              el,
              { opacity: 0, y: 14 },
              {
                opacity: 1,
                y: 0,
                duration: 0.6,
                ease: 'power3.out',
                clearProps: 'transform,opacity',
                ...(aboveFold
                  ? { delay: 0.05 }
                  : {
                      scrollTrigger: {
                        trigger: el,
                        start: 'top 88%',
                        once: true,
                      },
                    }),
              },
            );
            window.setTimeout(() => gsap.set(el, { clearProps: 'transform,opacity' }), 2500);
          }

          for (const group of groups) {
            const children = Array.from(group.children) as HTMLElement[];
            const aboveFold = group.getBoundingClientRect().top < window.innerHeight;
            gsap.fromTo(
              children,
              { opacity: 0, y: 14 },
              {
                opacity: 1,
                y: 0,
                duration: 0.55,
                ease: 'power3.out',
                stagger: 0.08,
                clearProps: 'transform,opacity',
                ...(aboveFold
                  ? { delay: 0.05 }
                  : {
                      scrollTrigger: {
                        trigger: group,
                        start: 'top 85%',
                        once: true,
                      },
                    }),
              },
            );
            window.setTimeout(() => {
              children.forEach((c) => gsap.set(c, { clearProps: 'transform,opacity' }));
            }, 2500);
          }

          ScrollTrigger.refresh();
        }

        /* 4 ── Rolling odometer counters ─────────────────────────────── */
        function initCounters(): void {
          const counters = Array.from(document.querySelectorAll<HTMLElement>('[data-count-to]'));
          if (counters.length === 0) return;

          for (const el of counters) {
            const target = Number(el.dataset.countTo ?? NaN);
            if (!Number.isFinite(target)) continue;
            const decimals = Number(el.dataset.decimals ?? 0);
            const prefix = el.dataset.prefix ?? '';
            const suffix = el.dataset.suffix ?? '';
            const fmt = (v: number): string =>
              `${prefix}${v.toLocaleString('en-US', { minimumFractionDigits: decimals, maximumFractionDigits: decimals })}${suffix}`;

            if (REDUCED.matches) {
              // Instant final value — never animate numbers under reduced motion.
              el.textContent = fmt(target);
              continue;
            }

            const state = { v: 0 };
            gsap.to(state, {
              v: target,
              duration: 1.4,
              ease: 'power3.out',
              scrollTrigger: {
                trigger: el,
                start: 'top 88%',
                once: true,
              },
              snap: { v: decimals > 0 ? 0 : 1 },
              onUpdate: () => {
                el.textContent = fmt(state.v);
              },
              onComplete: () => {
                el.textContent = fmt(target);
              },
            });
          }
        }

        /* 5 ── Theme-change hook for Canvas components ───────────────── */
        // Listeners receive the resolved mode and may re-read CSS variables
        // (getComputedStyle on :root / .instrument-chassis) to re-render.
        function dispatchThemeChange(): void {
          const mode: 'dark' | 'paper' = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'paper';
          window.dispatchEvent(new CustomEvent<{ mode: 'dark' | 'paper' }>('castor:theme-change', { detail: { mode } }));
        }

        /* ── Lenis smooth scroll + ScrollTrigger proxy ───────────────── */
        function init(): void {
          const instance = new Lenis({
            autoRaf: false, // driven by GSAP ticker below
            duration: 1.15,
            easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            smoothWheel: true,
            respectReducedMotion: true,
          });

          // Drive Lenis's animation loop from GSAP's ticker for unified timing.
          gsap.ticker.add((time: number) => {
            instance.raf(time * 1000);
          });
          gsap.ticker.lagSmoothing(0);

          // Tell ScrollTrigger to read/write through Lenis's virtual scroll.
          // GetterSetterNumFunc: called without args = getter, with value = setter.
          ScrollTrigger.scrollerProxy(window, {
            scrollTop(value?: number) {
              if (value === undefined) return instance.scroll;
              instance.scrollTo(value, { immediate: true, force: true });
            },
          });

          ScrollTrigger.addEventListener('refresh', () => {
            instance.resize();
          });
          ScrollTrigger.refresh();
          lenis = instance;

          initProgress();
          initHeroReveal();
          initReveal();
          initCounters();
          dispatchThemeChange();
        }

        function killAll(): void {
          motionKilled = true;
          const targets = Array.from(
            document.querySelectorAll<HTMLElement>(
              '[data-reveal], [data-stagger-group], [data-stagger-group] > *, [data-hero-reveal], .scroll-progress, [data-count-to]',
            ),
          );
          for (const st of ScrollTrigger.getAll()) st.kill();
          for (const el of targets) {
            gsap.killTweensOf(el);
            gsap.set(el, { clearProps: 'transform,opacity' });
          }
          // Counters always end on their final value.
          for (const el of document.querySelectorAll<HTMLElement>('[data-count-to]')) {
            const target = Number(el.dataset.countTo ?? NaN);
            if (Number.isFinite(target)) {
              const decimals = Number(el.dataset.decimals ?? 0);
              const prefix = el.dataset.prefix ?? '';
              const suffix = el.dataset.suffix ?? '';
              el.textContent = `${prefix}${target.toLocaleString('en-US', { minimumFractionDigits: decimals, maximumFractionDigits: decimals })}${suffix}`;
            }
          }
        }

        function destroy(): void {
          if (lenis) {
            lenis.destroy();
            lenis = null;
          }
          killAll();
          ScrollTrigger.refresh();
        }

        const onPref = (): void => {
          if (REDUCED.matches) {
            destroy();
          } else if (!lenis) {
            init();
          }
        };
        REDUCED.addEventListener('change', onPref);
        onPref();

        // Web fonts shift metrics on load; re-measure triggers once they settle.
        if (document.fonts && typeof document.fonts.ready?.then === 'function') {
          document.fonts.ready.then(() => ScrollTrigger.refresh()).catch(() => {});
        }
      }
    </script>
  </body>
</html>
