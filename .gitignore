# ====================================================================
# LLM_Ecosystem .gitignore
# ====================================================================

# Python environments & caches
.venv/
venv/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Secrets, Credentials, & Private Keys (CRITICAL)
api_key.txt
.webui_secret_key
*.key
*.pem
*.token
.env
.env.*
.git-credentials

# Large binaries, models & pre-compiled distributions
llama-cpp/
models/
*.gguf
*.safetensors
*.bin
*.pt
*.onnx

# Node.js dependencies & debug logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Benchmarks scratch directories & raw evaluation runs
benchmarks/swe-rebench/scratch/
benchmarks/swe-rebench/workspaces/
benchmarks/swe-rebench/__pycache__/
*.log

# IDE & AI Assistant internal / lock files
.claude/
.gemini/
.idea/
.vscode/
*.swp
*~
*.bak
*.tmp
*.orig

# Evo candidate lineage & runtime scratch
.scratch/
.evo/
.test_evo_tmp/
.avo/
.test_avo_tmp/
.test_live_tmp/
.benchmark_tmp/
.canary_tmp/
.wsl-tmp/

# Document & LaTeX build artifacts
*.aux
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
evals-faq.pdf

# Local-only research artifacts (never committed)
research/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Rust build artifacts
target/

# Local media studio workspace, logo scratch & draft PRs
video/
docs/assets/logos/
*.xlsx
HYPERQWEN_PR.md

